# Messenger Gateway / Telegram User Session
# Основной режим: рабочий Telegram-аккаунт сервиса по номеру телефона через MTProto.
# API ID/API Hash и encrypted session хранятся по филиалу в PostgreSQL.
MESSENGER_DEFAULT_ORG_ID=default
MESSENGER_CREDENTIAL_ENCRYPTION_KEY=dev-messenger-credential-key-change-me
TELEGRAM_SESSION_ENCRYPTION_KEY=dev-telegram-session-key-change-me

# Messenger media storage: для production используйте S3-compatible bucket/R2/MinIO.
MESSENGER_STORAGE_ENABLED=false
MESSENGER_STORAGE_ENDPOINT=
MESSENGER_STORAGE_REGION=auto
MESSENGER_STORAGE_BUCKET=
MESSENGER_STORAGE_ACCESS_KEY_ID=
MESSENGER_STORAGE_SECRET_ACCESS_KEY=
MESSENGER_STORAGE_PUBLIC_BASE_URL=
MESSENGER_STORAGE_FORCE_PATH_STYLE=true
MESSENGER_AUTO_DOWNLOAD_IMAGE_MAX_MB=15
MESSENGER_AUTO_DOWNLOAD_FILE_MAX_MB=25
MESSENGER_UPLOAD_MAX_MB=20
MESSENGER_MEDIA_WORKER_INTERVAL_MS=15000
MESSENGER_MEDIA_IN_PROCESS_WORKER=true

# T-Bank T-API: черновики платёжных поручений поставщикам.
TBANK_SECRET_ENCRYPTION_KEY=dev-tbank-secret-key-change-me
# TBANK_API_BASE_URL=https://business.tbank.ru/openapi
TBANK_WEBHOOK_IP_ALLOWLIST=0

# Legacy Bot API оставлен только для совместимости старых endpoint. В основном UI не используется.
