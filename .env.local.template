# Скопируйте в .env.local и замените заглушки на реальные значения:
#   cp .env.local.template .env.local
# Файл .env.local не коммитьте.

# Parts Catalogs API — https://api.parts-catalogs.com/v1
PARTS_CATALOGS_API_KEY=paste_your_parts_catalogs_key_here
# PARTS_CATALOGS_API_BASE=https://api.parts-catalogs.com/v1

OPENAI_API_KEY=sk-paste_your_openai_key_here
# OPENAI_OIL_MODEL=gpt-4o-mini

SERPER_API_KEY=paste_your_serper_key_here

# МойСклад: либо токен (предпочтительно), либо логин+пароль
MOYSKLAD_TOKEN=paste_moysklad_bearer_token_here
MOYSKLAD_LOGIN=
MOYSKLAD_PASSWORD=
DAYS_TO_SYNC=14
MOYSKLAD_ENABLED=false
MOYSKLAD_READ_ENABLED=false
MOYSKLAD_WRITE_ENABLED=false
MOYSKLAD_SYNC_ENABLED=false
MOYSKLAD_DEBUG_ENABLED=false
NEXT_PUBLIC_MOYSKLAD_DEBUG_ENABLED=false
# Rollback read-only профиль при критичной проблеме:
# MOYSKLAD_ENABLED=true
# MOYSKLAD_DEBUG_ENABLED=true
# MOYSKLAD_READ_ENABLED=true
# MOYSKLAD_SYNC_ENABLED=true
# MOYSKLAD_WRITE_ENABLED=false
# NEXT_PUBLIC_MOYSKLAD_DEBUG_ENABLED=true
# Не включайте MOYSKLAD_WRITE_ENABLED при rollback без отдельного решения.
# MOYSKLAD_TIMEOUT_MS=15000
# MOYSKLAD_LOOKUP_STOCK_CACHE_MS=600000
# MOYSKLAD_LOOKUP_OIL_CACHE_MS=1800000
# После первого импорта складского зеркала можно включить чтение из локальной БД
# LOCAL_INVENTORY_READS=1
# После проверки чтения можно включить локальную запись отгрузок и движение остатков
# LOCAL_INVENTORY_WRITES=1
# LOCAL_ORGANIZATION_NAME=Эко платформа
# LOCAL_INVENTORY_DEMAND_SEARCH_SCAN_LIMIT=2000

# Публичный API для клиентского сайта (/api/public/*)
PUBLIC_CLIENT_ORIGINS=https://client-site.ru
# PUBLIC_API_VIN_LIMIT_PER_HOUR=20
# PUBLIC_API_LEAD_LIMIT_PER_HOUR=5
# PUBLIC_LEAD_RESPONSIBLE_LOGIN=

# MOYSKLAD_ATTR_SAE=
# MOYSKLAD_ATTR_OEM=
# MOYSKLAD_ATTR_ACEA=
# MOYSKLAD_ATTR_API=
# MOYSKLAD_ATTR_ILSAC=
# MOYSKLAD_ATTR_VOLUME=
# MOYSKLAD_ATTR_CATEGORY=
# OIL_CACHE_DAYS=7

# Локальный вход: смените пароли
AUTH_USERS=owner:change-me-now:Владелец:owner,master1:change-me-too:Мастер:master
AUTH_SALT=dev-salt-change-in-production
SESSION_SECRET=dev-session-secret-use-openssl-rand-hex-32-in-prod

# PostgreSQL под вашу машину (логин/пароль/имя БД поправьте)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vin_oil
APP_TIMEZONE=Europe/Kaliningrad
CRON_SECRET=dev-cron-secret-change-me

# AQSI — вставьте ключ из личного кабинета AQSI
AQSI_API_KEY=paste_your_aqsi_api_key_here
# AQSI_BASE_URL=https://api.aqsi.ru/pub
# AQSI_ORDERS_PATH=/v2/Receipts
# AQSI_PENDING_ORDER_PATH=/v2/Orders/simple
# AQSI_DEVICE_ID=
# AQSI_SHOP_ID=
# AQSI_CASHIER_ID=
# Пароль для редкого пропуска моторного масла без кода маркировки
# AQSI_MARKING_BYPASS_PASSWORD=
