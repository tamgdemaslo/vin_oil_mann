# Rename this file to wg0.conf on the production server and replace every
# placeholder with the client configuration issued by the WireGuard provider.
# It must be a full tunnel: AllowedIPs has to contain 0.0.0.0/0.
#
# The enabled rules are a kill switch for the proxy namespace. They allow the
# private Compose network and tunnel traffic, but reject public traffic outside
# WireGuard if wg0 is unavailable.
[Interface]
Address = 10.0.0.2/32
PrivateKey = REPLACE_WITH_CLIENT_PRIVATE_KEY
DNS = 1.1.1.1

# Keep the peer endpoint as an IP address. This avoids a bootstrap DNS lookup
# outside the tunnel when the container starts.
[Peer]
PublicKey = REPLACE_WITH_SERVER_PUBLIC_KEY
Endpoint = 203.0.113.10:51820
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 25

# Allow local Docker traffic before applying the public-network kill switch.
# The WireGuard packet itself has a fwmark, so it is allowed to reach Endpoint.
PostUp = iptables -I OUTPUT 1 ! -o %i -m mark ! --mark $(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT
PostUp = iptables -I OUTPUT 1 -o %i -j ACCEPT
PostUp = iptables -I OUTPUT 1 -d 127.0.0.0/8 -j ACCEPT
PostUp = iptables -I OUTPUT 1 -d 10.0.0.0/8 -j ACCEPT
PostUp = iptables -I OUTPUT 1 -d 172.16.0.0/12 -j ACCEPT
PostUp = iptables -I OUTPUT 1 -d 192.168.0.0/16 -j ACCEPT
PostDown = iptables -D OUTPUT -d 192.168.0.0/16 -j ACCEPT
PostDown = iptables -D OUTPUT -d 172.16.0.0/12 -j ACCEPT
PostDown = iptables -D OUTPUT -d 10.0.0.0/8 -j ACCEPT
PostDown = iptables -D OUTPUT -d 127.0.0.0/8 -j ACCEPT
PostDown = iptables -D OUTPUT -o %i -j ACCEPT
PostDown = iptables -D OUTPUT ! -o %i -m mark ! --mark $(wg show %i fwmark) -m addrtype ! --dst-type LOCAL -j REJECT
