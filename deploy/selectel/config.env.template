# Non-secret host-side settings for deploy-image.sh. Copy to
# /opt/tgm/.deploy/config.env on the Selectel server.

APP_IMAGE_REPOSITORY=cr.selcloud.ru/replace-registry/eco-platform
MIGRATION_IMAGE_REPOSITORY=cr.selcloud.ru/replace-registry/eco-platform-migrations
PUBLIC_ORIGIN=https://www.tamgdemaslocrm.ru
SELECTEL_DATABASE_HOSTS=postgres

# Reuse the canonical production Compose network and persistent volumes.
COMPOSE_PROJECT_NAME=tgm

# Required only when deploy/selectel/wireguard/wg_confs/wg0.conf exists.
# Existing installations may retain their already-running local infrastructure
# image while application releases remain pinned to Registry digests.
WIREGUARD_PROXY_IMAGE=cr.selcloud.ru/replace-registry/eco-wireguard-proxy@sha256:replace

# Keep enough space for the candidate and previous standalone images.
MIN_FREE_KB=3145728
HEALTH_RETRIES=30
HEALTH_INTERVAL_SECONDS=2
POST_SWITCH_SAMPLES=3
POST_SWITCH_MAX_FAILURES=0
POST_SWITCH_OBSERVATION_SECONDS=600
POST_SWITCH_INTERVAL_SECONDS=20
