# Copy this file to .env.production on the Selectel server. Do not commit it.
# Add every production variable from Railway, then replace DATABASE_URL with the
# local Postgres service address below.

POSTGRES_USER=vin_oil
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=vin_oil
DATABASE_URL=postgresql://vin_oil:replace-with-a-long-random-password@postgres:5432/vin_oil

NODE_ENV=production
PORT=3000
APP_ORIGIN=https://www.tamgdemaslocrm.ru
NEXT_PUBLIC_APP_ORIGIN=https://www.tamgdemaslocrm.ru
NEXT_PUBLIC_SITE_URL=https://www.tamgdemaslocrm.ru
CHROME_PATH=/usr/bin/chromium
APP_DATA_DIR=/app/.data
READINESS_CHECK_TIMEOUT_MS=3000

# OpenAI — обязателен для внутреннего ИИ-помощника и ИИ-функций подбора.
# Создайте project API key в OpenAI Platform и вставьте его только в локальный
# файл /opt/tgm/.env.production на сервере. Не коммитьте значение в репозиторий.
OPENAI_API_KEY=sk-paste_your_openai_key_here
OPENAI_ADMIN_ASSISTANT_MODEL=gpt-5.6-terra
OPENAI_ADMIN_ASSISTANT_REASONING=max

# Release identity is supplied per blue/green slot by deploy-image.sh. Do not
# set APP_RELEASE, APP_COMMIT_SHA, APP_IMAGE_DIGEST or APP_BUILT_AT here.

# Keep false until Branch 1 migration, isolation tests and the Selectel
# go/no-go checklist are complete. The API still permits first-branch bootstrap.
BRANCH_CREATION_ENABLED=false

# Optional: route only the Telegram user-session integration through SOCKS.
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_PROXY_SOCKS_TYPE=5

# Telegram and OpenAI use the private WireGuard proxy only when
# docker-compose.selectel.wireguard.yml is enabled. Do not set OPENAI_PROXY_URL
# or TELEGRAM_PROXY_* manually: the compose override supplies them, including
# TELEGRAM_HTTP_PROXY_URL for Bot API calls.
