# Dedicated Timeweb client application, root Dockerfile / final app stage.
# Checked 2026-10-10: ru-3, preset 2733, 1 CPU / 2 GB. Verify price before creation.
DEPLOYMENT_PROVIDER=timeweb
APP_ORIGIN=https://tamgdemaslo.ru
CLIENT_SITE_ONLY=true
PUBLIC_CLIENT_SITE_ORIGIN=https://tamgdemaslo.ru
PUBLIC_CLIENT_SITE_BASE_PATH=/
PUBLIC_CLIENT_SITE_HOSTS=tamgdemaslo.ru,www.tamgdemaslo.ru
PUBLIC_BOOKING_ORIGIN=https://tamgdemaslo.ru
PUBLIC_CLIENT_VIN_ORIGIN=https://www.tamgdemaslocrm.ru
APP_IN_PROCESS_BACKGROUND_WORKERS_ENABLED=0
PRISMA_CONNECTION_LIMIT=3
PRISMA_POOL_TIMEOUT_SECONDS=10

# Set DATABASE_URL and the verified APP_EXPECTED_MIGRATION in Timeweb only.
# The database stays shared with CRM; no migration or data copy is required.
# Booking requests use CRM so existing signatures and notification delivery stay there.
# Preserve CRM's PUBLIC_STOREFRONT_SLUG and PUBLIC_API/PUBLIC_BOOKING limits.
# VIN and booking use CRM's public HTTPS endpoints: do not copy CRM integration keys,
# WireGuard profiles, banking/messenger credentials or the notification cron.
# Before DNS cutover, retain old A 176.57.65.76 and www CNAME tamgdemaslo.ru.
# Point only the domain's A record at the new app IP after testing HTTPS/SSR.
# Keep existing mail and TXT records. If moving DNS management to REG.RU,
# recreate the zone before switching nameservers to ns1.reg.ru / ns2.reg.ru.
# After DNS cutover: set PUBLIC_CLIENT_SITE_ORIGIN, PUBLIC_CLIENT_SITE_BASE_PATH,
# PUBLIC_BOOKING_ORIGIN and PUBLIC_CLIENT_SITE_REDIRECT_LEGACY=true in CRM.
