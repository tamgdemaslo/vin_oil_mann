  organizationId         String    @default("default") @map("organization_id")
  channel                String
  messengerAccountId     String    @map("messenger_account_id")
  externalUserId         String    @map("external_user_id")
  externalConversationId String?   @map("external_conversation_id")
  username               String?
  displayName            String?   @map("display_name")
  phoneNormalized        String?   @map("phone_normalized")
