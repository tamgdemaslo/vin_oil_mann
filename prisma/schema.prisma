  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([branchId, sessionId, itemCode])
  @@unique([sessionId, itemCode])
  @@unique([branchId, id])
  @@index([sessionId])
  @@index([status])
  @@map("diagnostic_map_items")
}

model DiagnosticMapPhoto {
  id       String            @id @default(cuid())
  branchId String            @default("branch-main") @map("branch_id")
  itemId   String            @map("item_id")
