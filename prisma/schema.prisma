  organizationId String    @default("default") @map("organization_id")
  telegramEnabled Boolean  @default(true) @map("telegram_enabled")
  consentStatus  String    @default("unknown") @map("consent_status")
  consentSource  String?   @map("consent_source")
  consentAt      DateTime? @map("consent_at") @db.Timestamptz(6)
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, telegramEnabled, consentStatus])
  @@map("client_notification_preferences")
}

model CommunicationIdentity {
