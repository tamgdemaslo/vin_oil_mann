/// Immutable working snapshot of an internal assistant calculation.  It is
/// deliberately separate from the retired client-agent quote model: this
/// record is for an employee to review and turn into a message, never for
/// automatic customer delivery or accounting mutations.
model AIAssistantQuote {
  id                       String            @id @default(cuid())
  branchId                 String            @default("branch-main") @map("branch_id")
  organizationId           String            @default("default") @map("organization_id")
  threadId                 String            @map("thread_id")
  thread                   AIAssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  runId                    String?           @map("run_id")
  run                      AIAssistantRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdById              String            @map("created_by_id")
  status                   String            @default("draft")
  vehicleId                String?           @map("vehicle_id")
  vehicleDisplayName       String?           @map("vehicle_display_name")
  vehicleSnapshotJson      Json              @default("{}") @map("vehicle_snapshot_json")
  serviceName              String?           @map("service_name")
  selectedScenario         String?           @map("selected_scenario")
  appliedRuleId            String?           @map("applied_rule_id")
  appliedRuleSnapshotJson  Json              @default("{}") @map("applied_rule_snapshot_json")
  includedItemsJson        Json              @default("[]") @map("included_items_json")
  optionalItemsJson        Json              @default("[]") @map("optional_items_json")
  baseTotalCents           Int               @map("base_total_cents")
  maximumTotalCents        Int?              @map("maximum_total_cents")
  priceRangeJson           Json              @default("{}") @map("price_range_json")
  assumptionsJson          Json              @default("[]") @map("assumptions_json")
  internalWarningsJson     Json              @default("[]") @map("internal_warnings_json")
  customerSafeWarningsJson Json              @default("[]") @map("customer_safe_warnings_json")
  validUntil               DateTime?         @map("valid_until") @db.Timestamptz(6)
  isSelected               Boolean           @default(true) @map("is_selected")
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, threadId, isSelected, createdAt])
  @@index([organizationId, runId])
  @@map("ai_assistant_quotes")
}

/// Configurable labour tariff used by the internal assistant.  It is kept
/// independently from LocalProduct because a service-card price is not a
/// reliable price for technically different procedures.
model AIAssistantLaborPricingRule {
  id                        String    @id @default(cuid())
  branchId                  String    @default("branch-main") @map("branch_id")
  organizationId            String    @default("default") @map("organization_id")
  locationId                String    @default("dachnaya") @map("location_id")
  serviceFamily             String    @map("service_family")
  procedureType             String    @map("procedure_type")
  transmissionConfiguration String?   @map("transmission_configuration")
  materialsOwner            String?   @map("materials_owner")
  /// Optional narrower scope has priority over generic scenario rules.
  vehicleId                 String?   @map("vehicle_id")
  aggregateCode             String?   @map("aggregate_code")
  name                      String
  laborPriceCents           Int       @map("labor_price_cents")
  priceFromCents            Int?      @map("price_from_cents")
  priceToCents              Int?      @map("price_to_cents")
  requiresHumanConfirmation Boolean   @default(false) @map("requires_human_confirmation")
  active                    Boolean   @default(true)
  effectiveFrom             DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo               DateTime? @map("effective_to") @db.Timestamptz(6)
  comment                   String?   @db.Text
  createdById               String?   @map("created_by_id")
  updatedById               String?   @map("updated_by_id")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, locationId, active, effectiveFrom, effectiveTo])
  @@index([organizationId, vehicleId, aggregateCode])
  @@index([organizationId, serviceFamily, procedureType, transmissionConfiguration, materialsOwner])
  @@map("ai_assistant_labor_pricing_rules")
}

/// Confirmed difficulty of replacing a particular air or cabin filter.  No
/// default price is inferred from a difficulty label: only this rule carries
/// an amount that the assistant may use without asking an employee.
model VehicleServiceComplexityRule {
  id              String   @id @default(cuid())
  branchId        String   @default("branch-main") @map("branch_id")
  organizationId  String   @default("default") @map("organization_id")
  make            String
  model           String
  generation      String?
  yearFrom        Int?     @map("year_from")
  yearTo          Int?     @map("year_to")
  engineCode      String?  @map("engine_code")
  serviceType     String   @map("service_type")
  complexity      String
  laborPriceCents Int      @map("labor_price_cents")
  source          String?
  confirmedById   String?  @map("confirmed_by_id")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, make, model, serviceType, active])
  @@map("vehicle_service_complexity_rules")
}
