// Смены, ставки, бонусы/штрафы. Пользователи — по логину из AUTH_USERS,
// а измененные пароли хранятся отдельно в БД.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shift {
  id                   String    @id @default(cuid())
  userLogin            String
  shiftDate            String // YYYY-MM-DD (локальный день смены)
  startedAt            DateTime  @map("started_at")
  endedAt              DateTime? @map("ended_at")
  closeType            String    @default("by_employee") @map("close_type") // by_employee | by_owner | auto
  closedByLogin        String?   @map("closed_by_login")
  latePenaltyCents     Int?      @map("late_penalty_cents")
  unclosedPenaltyCents Int?      @map("unclosed_penalty_cents")

  @@unique([userLogin, shiftDate])
  @@map("shifts")
}

model ShiftRate {
  id            String @id @default(cuid())
  userLogin     String @map("user_login")
  amountCents   Int    @map("amount_cents")
  effectiveFrom String @map("effective_from") // YYYY-MM-DD, новая ставка только на будущие смены

  @@map("shift_rates")
}

model PieceworkRule {
  id                 String   @id @default(cuid())
  targetType         String   @map("target_type") // service | product_group
  targetId           String   @map("target_id")
  targetName         String   @map("target_name")
  role               String
  mode               String // fixed | percent
  fixedCents         Int?     @map("fixed_cents")
  percentBasisPoints Int?     @map("percent_basis_points")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([targetType, targetId, role])
  @@map("piecework_rules")
}

model BonusPenalty {
  id             String   @id @default(cuid())
  userLogin      String   @map("user_login")
  date           String // YYYY-MM-DD
  amountCents    Int      @map("amount_cents") // бонус > 0, штраф < 0
  type           String // bonus | penalty_late | penalty_unclosed | penalty_manual
  comment        String?  @db.Text
  createdByLogin String   @map("created_by_login")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("bonus_penalties")
}

model ChangeLog {
  id               String   @id @default(cuid())
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  action           String // create | update | delete
  oldValue         Json?    @map("old_value")
  newValue         Json?    @map("new_value")
  performedByLogin String   @map("performed_by_login")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("change_logs")
}

// Назначенные владельцем рабочие дни сотрудника (график)
model ScheduledWorkingDay {
  id             String   @id @default(cuid())
  userLogin      String   @map("user_login")
  date           String // YYYY-MM-DD
  createdByLogin String   @map("created_by_login")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userLogin, date])
  @@map("scheduled_working_days")
}

model AuthPassword {
  login        String   @id
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("auth_passwords")
}

/// Слепок отгрузок МойСклад для аналитики по клиентам (только applicable)
model MoySkladDemandSync {
  id                String   @id
  documentDate      String   @map("document_date")
  momentAt          DateTime @map("moment_at")
  applicable        Boolean
  sumCents          Int      @map("sum_cents")
  name              String
  agentMetaHref     String?  @map("agent_meta_href")
  agentNameSnapshot String?  @map("agent_name_snapshot")
  phonesRaw         Json?    @map("phones_raw")
  normalizedPhone   String?  @map("normalized_phone")
  hasIncompleteCost Boolean  @default(false) @map("has_incomplete_cost")
  positionCount     Int      @default(0) @map("position_count")
  /**
   * Прибыль по строкам документа (копейки), считается при синхронизации
   */
  profitCents       Int      @default(0) @map("profit_cents")
  /**
   * Услуги в документе по порядку первого вхождения: [{ "id", "name" }]
   */
  documentServices  Json?    @map("document_services")
  syncedAt          DateTime @default(now()) @map("synced_at")

  positions MoySkladDemandPositionSync[]

  @@index([normalizedPhone])
  @@index([documentDate])
  @@index([momentAt])
  @@map("moysklad_demand_sync")
}

/// Позиции отгрузки для сегментации по услугам и расчёта себестоимости
model MoySkladDemandPositionSync {
  id                   String             @id
  demandId             String             @map("demand_id")
  demand               MoySkladDemandSync @relation(fields: [demandId], references: [id], onDelete: Cascade)
  assortmentType       String             @map("assortment_type")
  assortmentId         String?            @map("assortment_id")
  name                 String
  quantity             Float
  priceCentsPerUnit    Int                @map("price_cents_per_unit")
  discount             Float              @default(0)
  buyPriceCentsPerUnit Int?               @map("buy_price_cents_per_unit")
  lineIncompleteCost   Boolean            @default(false) @map("line_incomplete_cost")

  @@index([demandId])
  @@index([assortmentType, assortmentId])
  @@map("moysklad_demand_position_sync")
}

/// Состояние синхронизации (одна строка)
model MoySkladAnalyticsSyncState {
  id                   String    @id
  updatedAt            DateTime  @updatedAt @map("updated_at")
  lastSyncedAt         DateTime? @map("last_synced_at")
  lastError            String?   @map("last_error") @db.Text
  demandsSynced        Int       @default(0) @map("demands_synced")
  syncRunning          Boolean   @default(false) @map("sync_running")
  syncMode             String?   @map("sync_mode")
  syncPhase            String?   @map("sync_phase")
  syncStartedAt        DateTime? @map("sync_started_at")
  syncFinishedAt       DateTime? @map("sync_finished_at")
  syncHeartbeatAt      DateTime? @map("sync_heartbeat_at")
  syncTotalDemands     Int?      @map("sync_total_demands")
  syncProcessedDemands Int       @default(0) @map("sync_processed_demands")
  syncScannedDemands   Int       @default(0) @map("sync_scanned_demands")
  syncLastDemandId     String?   @map("sync_last_demand_id")
  syncLastDemandName   String?   @map("sync_last_demand_name")
  syncMessage          String?   @map("sync_message") @db.Text

  @@map("moysklad_analytics_sync_state")
}

/// Пороги статусов аналитики (singleton id = default)
model CustomerAnalyticsSettings {
  id                    String @id @default("default")
  inactiveDaysThreshold Int    @default(365) @map("inactive_days_threshold")
  regularVisitThreshold Int    @default(5) @map("regular_visit_threshold")
  vipThresholdCents     Int?   @map("vip_threshold_cents")
  vipMetric             String @default("revenue") @map("vip_metric")
  vipWindow             String @default("all") @map("vip_window")

  @@map("customer_analytics_settings")
}

model VinLookupCache {
  vin       String   @id @db.Text
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "vin_lookup_cache_expires_at_idx")
  @@map("vin_lookup_cache")
}

model CrmStage {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @map("sort_order")
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deals CrmDeal[]

  @@unique([sortOrder])
  @@map("crm_stages")
}

model CrmDeal {
  id                       String    @id @default(cuid())
  title                    String
  customerName             String?   @map("customer_name")
  phoneNormalized          String?   @map("phone_normalized")
  vehicle                  String?
  source                   String?
  amountCents              Int?      @map("amount_cents")
  stageId                  String    @map("stage_id")
  responsibleLogin         String?   @map("responsible_login")
  moyskladCounterpartyId   String?   @map("moysklad_counterparty_id")
  moyskladCounterpartyName String?   @map("moysklad_counterparty_name")
  moyskladCounterpartyHref String?   @map("moysklad_counterparty_href") @db.Text
  yclientsRecordId         String?   @map("yclients_record_id")
  moyskladDemandId         String?   @map("moysklad_demand_id")
  nextContactAt            DateTime? @map("next_contact_at")
  status                   String    @default("open") // open | won | lost
  notes                    String?   @db.Text
  createdByLogin           String    @map("created_by_login")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  stage CrmStage @relation(fields: [stageId], references: [id])

  @@index([phoneNormalized])
  @@index([moyskladCounterpartyId])
  @@index([stageId])
  @@index([status])
  @@map("crm_deals")
}

// --- Диагностический лист при отгрузке ---

enum DiagnosticStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum DiagnosticBlock {
  AGGREGATE_FLUID
  SERVICE_FLUID
  VISUAL
  SURVEY
}

enum DiagnosticPositionStatus {
  NOT_CHECKED
  GREEN
  YELLOW
  RED
  SKIPPED
}

model Diagnostic {
  id                 String  @id @default(uuid())
  shipmentMoySkladId String? @map("shipment_moysklad_id")
  shipmentDraftId    String? @map("shipment_draft_id")
  agentMoySkladId    String? @map("agent_moysklad_id")

  vin          String?
  brand        String?
  model        String?
  year         Int?
  licensePlate String? @map("license_plate")
  mileage      Int?

  mechanicLogin String? @map("mechanic_login")

  status              DiagnosticStatus @default(IN_PROGRESS)
  startedAt           DateTime         @default(now()) @map("started_at")
  completedAt         DateTime?        @map("completed_at")
  clientReportSentAt  DateTime?        @map("client_report_sent_at")
  clientReportToken   String           @unique @default(uuid()) @map("client_report_token")
  clientWantsReminder Boolean          @default(true) @map("client_wants_reminder")

  summaryGreen  Int @default(0) @map("summary_green")
  summaryYellow Int @default(0) @map("summary_yellow")
  summaryRed    Int @default(0) @map("summary_red")

  positions DiagnosticPosition[]
  offers    DiagnosticOffer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vin])
  @@index([agentMoySkladId])
  @@index([shipmentMoySkladId])
  @@map("diagnostics")
}

model DiagnosticPosition {
  id           String     @id @default(uuid())
  diagnosticId String     @map("diagnostic_id")
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  block  DiagnosticBlock
  node   String
  status DiagnosticPositionStatus @default(NOT_CHECKED)

  tags             String[]
  measurementValue Decimal? @map("measurement_value") @db.Decimal(10, 2)
  measurementUnit  String?  @map("measurement_unit")
  recommendation   String?
  notes            String?  @db.Text

  photos DiagnosticPhoto[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([diagnosticId, node])
  @@index([diagnosticId])
  @@map("diagnostic_positions")
}

model DiagnosticPhoto {
  id         String             @id @default(uuid())
  positionId String             @map("position_id")
  position   DiagnosticPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  filePath String  @map("file_path")
  caption  String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([positionId])
  @@map("diagnostic_photos")
}

model DiagnosticOffer {
  id           String     @id @default(uuid())
  diagnosticId String     @map("diagnostic_id")
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  relatedPositionId    String? @map("related_position_id")
  offerKey             String  @map("offer_key")
  title                String
  variants             Json
  selectedVariantIndex Int?    @map("selected_variant_index")
  addedToShipment      Boolean @default(false) @map("added_to_shipment")
  nextVisitOnly        Boolean @default(false) @map("next_visit_only")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([diagnosticId])
  @@map("diagnostic_offers")
}

// --- Локальное складское ядро ---

/// Локальный справочник организаций для документов.
model LocalOrganization {
  id           String   @id @default(cuid())
  moyskladId   String?  @unique @map("moysklad_id")
  moyskladHref String?  @map("moysklad_href") @db.Text
  name         String
  isActive     Boolean  @default(true) @map("is_active")
  raw          Json?
  syncedAt     DateTime @default(now()) @map("synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  demands LocalDemand[]

  @@index([name])
  @@index([isActive])
  @@map("local_organizations")
}

/// Справочник складов, импортированный из МойСклад и пригодный для дальнейшей локальной работы.
model LocalStore {
  id           String   @id @default(cuid())
  moyskladId   String?  @unique @map("moysklad_id")
  moyskladHref String?  @map("moysklad_href") @db.Text
  name         String
  isMain       Boolean  @default(false) @map("is_main")
  archived     Boolean  @default(false)
  raw          Json?
  syncedAt     DateTime @default(now()) @map("synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stockBalances      LocalStockBalance[]
  demands            LocalDemand[]
  inventoryDocuments LocalInventoryDocument[]

  @@index([name])
  @@map("local_stores")
}

/// Локальный справочник ассортимента: товары, услуги и модификации.
model LocalProduct {
  id                     String   @id @default(cuid())
  moyskladId             String?  @unique @map("moysklad_id")
  moyskladHref           String?  @map("moysklad_href") @db.Text
  entityType             String   @default("product") @map("entity_type")
  name                   String
  article                String?
  code                   String?
  externalCode           String?  @map("external_code")
  groupPath              String?  @map("group_path") @db.Text
  uomName                String?  @map("uom_name")
  salePriceCents         Int      @default(0) @map("sale_price_cents")
  buyPriceCents          Int?     @map("buy_price_cents")
  currencyName           String?  @map("currency_name")
  minimumBalance         Decimal? @map("minimum_balance") @db.Decimal(14, 3)
  barcodeEan13           String?  @map("barcode_ean13") @db.Text
  barcodeEan8            String?  @map("barcode_ean8") @db.Text
  barcodeCode128         String?  @map("barcode_code128") @db.Text
  description            String?  @db.Text
  minPriceCents          Int?     @map("min_price_cents")
  minPriceCurrencyName   String?  @map("min_price_currency_name")
  countryName            String?  @map("country_name")
  vatLabel               String?  @map("vat_label")
  supplierName           String?  @map("supplier_name")
  weight                 Decimal? @db.Decimal(14, 3)
  volume                 Decimal? @db.Decimal(14, 3)
  modificationCode       String?  @map("modification_code")
  tnvedCode              String?  @map("tnved_code")
  sae                    String?
  oem                    String?  @db.Text
  acea                   String?
  apiSpec                String?  @map("api_spec")
  packageVolume          String?  @map("package_volume")
  avito                  Boolean?
  brand                  String?
  atf                    String?
  ilsac                  String?
  aceaExtra              String?  @map("acea_extra")
  oemAtf                 String?  @map("oem_atf") @db.Text
  mannName               String?  @map("mann_name")
  rosskoPartNumber       String?  @map("rossko_part_number")
  rosskoBrand            String?  @map("rossko_brand")
  rosskoMin              String?  @map("rossko_min")
  supplierAttribute      String?  @map("supplier_attribute")
  oemParts               String?  @map("oem_parts") @db.Text
  cell                   String?
  params                 String?  @db.Text
  mannCharacteristicName String?  @map("mann_characteristic_name")
  imageHref              String?  @map("image_href") @db.Text
  attributes             Json?
  searchText             String   @default("") @map("search_text") @db.Text
  archived               Boolean  @default(false)
  raw                    Json?
  syncedAt               DateTime @default(now()) @map("synced_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  stockBalances              LocalStockBalance[]
  demandPositions            LocalDemandPosition[]
  inventoryDocumentPositions LocalInventoryDocumentPosition[]
  photos                     LocalProductPhoto[]

  @@index([entityType])
  @@index([name])
  @@index([article])
  @@index([code])
  @@index([externalCode])
  @@index([brand])
  @@index([sae])
  @@index([supplierName])
  @@index([groupPath])
  @@index([apiSpec])
  @@index([acea])
  @@index([packageVolume])
  @@index([salePriceCents])
  @@index([buyPriceCents])
  @@index([updatedAt])
  @@map("local_products")
}

model LocalProductPhoto {
  id          String       @id @default(cuid())
  productId   String       @map("product_id")
  product     LocalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName    String?      @map("file_name")
  contentType String       @map("content_type")
  sizeBytes   Int          @map("size_bytes")
  data        Bytes
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([productId])
  @@map("local_product_photos")
}

/// Локальные остатки ассортимента по складам.
model LocalStockBalance {
  id        String       @id @default(cuid())
  productId String       @map("product_id")
  product   LocalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String       @map("store_id")
  store     LocalStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  quantity  Decimal  @default(0) @db.Decimal(14, 3)
  reserve   Decimal  @default(0) @db.Decimal(14, 3)
  available Decimal  @default(0) @db.Decimal(14, 3)
  buyPriceCents Int?  @map("buy_price_cents")
  slotName  String?  @map("slot_name")
  syncedAt  DateTime @default(now()) @map("synced_at")

  @@unique([productId, storeId])
  @@index([productId])
  @@index([storeId])
  @@index([available])
  @@map("local_stock_balances")
}

/// Локальный справочник контрагентов.
model LocalCounterparty {
  id                   String    @id @default(cuid())
  moyskladId           String?   @unique @map("moysklad_id")
  moyskladHref         String?   @map("moysklad_href") @db.Text
  name                 String
  phone                String?
  email                String?
  normalizedPhone      String?   @map("normalized_phone")
  phonesRaw            Json?     @map("phones_raw")
  companyType          String?   @map("company_type")
  counterpartyTypeName String?   @map("counterparty_type_name")
  legalTitle           String?   @map("legal_title")
  legalLastName        String?   @map("legal_last_name")
  legalFirstName       String?   @map("legal_first_name")
  legalMiddleName      String?   @map("legal_middle_name")
  legalAddress         String?   @map("legal_address") @db.Text
  inn                  String?
  kpp                  String?
  okpo                 String?
  fax                  String?
  bik                  String?
  bankName             String?   @map("bank_name")
  bankLocation         String?   @map("bank_location") @db.Text
  correspondentAccount String?   @map("correspondent_account")
  checkingAccount      String?   @map("checking_account")
  ogrn                 String?
  ogrnip               String?
  certificateNumber    String?   @map("certificate_number")
  certificateDate      DateTime? @map("certificate_date") @db.Date
  searchText           String    @default("") @map("search_text") @db.Text
  archived             Boolean   @default(false)
  raw                  Json?
  syncedAt             DateTime  @default(now()) @map("synced_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  demands            LocalDemand[]
  inventoryDocuments LocalInventoryDocument[]

  @@index([name])
  @@index([normalizedPhone])
  @@index([inn])
  @@map("local_counterparties")
}

/// Локальные отгрузки. На первом этапе это зеркало МойСклад, дальше станет рабочей сущностью.
model LocalDemand {
  id           String   @id @default(cuid())
  moyskladId   String?  @unique @map("moysklad_id")
  moyskladHref String?  @map("moysklad_href") @db.Text
  name         String
  momentAt     DateTime @map("moment_at")
  documentDate String   @map("document_date")
  applicable   Boolean  @default(false)
  sumCents     Int      @default(0) @map("sum_cents")
  description  String?  @db.Text

  counterpartyId    String?            @map("counterparty_id")
  counterparty      LocalCounterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  agentMoyskladId   String?            @map("agent_moysklad_id")
  agentNameSnapshot String?            @map("agent_name_snapshot")

  storeId           String?     @map("store_id")
  store             LocalStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeMoyskladId   String?     @map("store_moysklad_id")
  storeNameSnapshot String?     @map("store_name_snapshot")
  organizationId    String?            @map("organization_id")
  organization      LocalOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationName  String?     @map("organization_name")

  attributes Json?
  raw        Json?
  syncedAt   DateTime @default(now()) @map("synced_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  positions LocalDemandPosition[]

  @@index([documentDate])
  @@index([momentAt])
  @@index([applicable])
  @@index([counterpartyId])
  @@index([agentMoyskladId])
  @@index([storeId])
  @@index([organizationId])
  @@map("local_demands")
}

/// Позиции локальной отгрузки.
model LocalDemandPosition {
  id                   String        @id @default(cuid())
  demandId             String        @map("demand_id")
  demand               LocalDemand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  moyskladPositionId   String?       @unique @map("moysklad_position_id")
  productId            String?       @map("product_id")
  product              LocalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  assortmentMoyskladId String?       @map("assortment_moysklad_id")
  assortmentType       String        @map("assortment_type")
  name                 String
  quantity             Decimal       @default(0) @db.Decimal(14, 3)
  priceCentsPerUnit    Int           @default(0) @map("price_cents_per_unit")
  discount             Decimal       @default(0) @db.Decimal(7, 3)
  vat                  Int           @default(0)
  vatEnabled           Boolean       @default(false) @map("vat_enabled")
  buyPriceCentsPerUnit Int?          @map("buy_price_cents_per_unit")
  slotName             String?       @map("slot_name")
  raw                  Json?

  @@index([demandId])
  @@index([productId])
  @@index([assortmentType, assortmentMoyskladId])
  @@map("local_demand_positions")
}

/// Локальные определения дополнительных полей отгрузки.
model DemandAttributeDefinition {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("string")
  required  Boolean  @default(false)
  order     Int      @default(0)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name])
  @@index([order])
  @@map("demand_attribute_definitions")
}

/// Локальные складские документы: приёмка, списание и будущие корректировки.
model LocalInventoryDocument {
  id           String   @id @default(cuid())
  type         String
  name         String
  momentAt     DateTime @map("moment_at")
  documentDate String   @map("document_date")
  applicable   Boolean  @default(true)
  sumCents     Int      @default(0) @map("sum_cents")
  description  String?  @db.Text

  counterpartyId           String?            @map("counterparty_id")
  counterparty             LocalCounterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  counterpartyNameSnapshot String?            @map("counterparty_name_snapshot")

  storeId           String?     @map("store_id")
  store             LocalStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeNameSnapshot String?     @map("store_name_snapshot")

  createdByLogin String?  @map("created_by_login")
  createdByName  String?  @map("created_by_name")
  raw            Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  positions       LocalInventoryDocumentPosition[]
  supplierInvoice LocalSupplierInvoice?

  @@index([type])
  @@index([documentDate])
  @@index([momentAt])
  @@index([applicable])
  @@index([counterpartyId])
  @@index([storeId])
  @@map("local_inventory_documents")
}

/// Позиции локального складского документа.
model LocalInventoryDocumentPosition {
  id                String                 @id @default(cuid())
  documentId        String                 @map("document_id")
  document          LocalInventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId         String?                @map("product_id")
  product           LocalProduct?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName       String                 @map("product_name")
  quantity          Decimal                @default(0) @db.Decimal(14, 3)
  priceCentsPerUnit Int                    @default(0) @map("price_cents_per_unit")
  slotName          String?                @map("slot_name")
  raw               Json?

  @@index([documentId])
  @@index([productId])
  @@map("local_inventory_document_positions")
}

/// Локальный счёт поставщика, созданный из приёмки.
model LocalSupplierInvoice {
  id                       String                 @id @default(cuid())
  documentId               String                 @unique @map("document_id")
  document                 LocalInventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  number                   String?
  invoiceDate              String                 @map("invoice_date")
  dueDate                  String?                @map("due_date")
  status                   String                 @default("unpaid")
  sumCents                 Int                    @default(0) @map("sum_cents")
  counterpartyNameSnapshot String?                @map("counterparty_name_snapshot")
  raw                      Json?
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  @@index([invoiceDate])
  @@index([dueDate])
  @@index([status])
  @@index([counterpartyNameSnapshot])
  @@map("local_supplier_invoices")
}

/// Состояние импорта локального складского зеркала.
model LocalInventorySyncState {
  id                   String    @id @default("default")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  lastSyncedAt         DateTime? @map("last_synced_at")
  lastError            String?   @map("last_error") @db.Text
  productsSynced       Int       @default(0) @map("products_synced")
  servicesSynced       Int       @default(0) @map("services_synced")
  counterpartiesSynced Int       @default(0) @map("counterparties_synced")
  storesSynced         Int       @default(0) @map("stores_synced")
  stockRowsSynced      Int       @default(0) @map("stock_rows_synced")
  demandsSynced        Int       @default(0) @map("demands_synced")
  syncRunning          Boolean   @default(false) @map("sync_running")
  syncMode             String?   @map("sync_mode")
  syncPhase            String?   @map("sync_phase")
  syncStartedAt        DateTime? @map("sync_started_at")
  syncFinishedAt       DateTime? @map("sync_finished_at")
  syncMessage          String?   @map("sync_message") @db.Text

  @@map("local_inventory_sync_state")
}
