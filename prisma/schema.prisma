  requirements VehicleFluidRequirement[]

  @@index([importBatchId])
  @@index([makeNormalized, modelNormalized])
  @@index([sourcePageHash])
  @@map("fluid_source_rows")
}

/// Нормализованное требование по одному узлу автомобиля. Исходный текст всегда
/// сохраняется рядом, поэтому уточнение парсера не требует повторного скрейпинга.
model VehicleFluidRequirement {
  id                      String                   @id
  importBatchId           String?                  @map("import_batch_id")
  importBatch             FluidCatalogImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  sourceRowId             String                   @map("source_row_id")
  sourceRow               FluidSourceRow           @relation(fields: [sourceRowId], references: [id], onDelete: Cascade)
  sourceTableKey          String                   @map("source_table_key")
  sourceUrl               String                   @map("source_url") @db.Text
  make                    String
  makeNormalized          String                   @map("make_normalized")
  model                   String
  modelNormalized         String                   @map("model_normalized")
  generation              String?
  generationNumber        Int?                     @map("generation_number")
  bodyCodesJson           Json                     @default("[]") @map("body_codes_json")
  yearFrom                Int?                     @map("year_from")
  yearTo                  Int?                     @map("year_to")
  engineCodeNormalized    String?                  @map("engine_code_normalized")
  engineCodesJson         Json                     @default("[]") @map("engine_codes_json")
  engineVolumeCc          Int?                     @map("engine_volume_cc")
  powerKw                 Int?                     @map("power_kw")
  powerHp                 Int?                     @map("power_hp")
  fuelType                String?                  @map("fuel_type")
  driveType               String?                  @map("drive_type")
  transmissionType        String?                  @map("transmission_type")
  componentModel          String?                  @map("component_model") @db.Text
  systemCode              String                   @map("system_code")
  systemNameRaw           String                   @map("system_name_raw") @db.Text
  fillVolumeText          String?                  @map("fill_volume_text") @db.Text
  fillVolumeMinLiters     Float?                   @map("fill_volume_min_liters")
  fillVolumeMaxLiters     Float?                   @map("fill_volume_max_liters")
  serviceVolumeLiters     Float?                   @map("service_volume_liters")
  totalVolumeLiters       Float?                   @map("total_volume_liters")
  capacitiesJson          Json                     @default("[]") @map("capacities_json")
  specificationText       String?                  @map("specification_text") @db.Text
  specificationsJson      Json                     @default("[]") @map("specifications_json")
  viscosityGradesJson     Json                     @default("[]") @map("viscosity_grades_json")
  recommendationText      String?                  @map("recommendation_text") @db.Text
  replacementIntervalText String?                  @map("replacement_interval_text") @db.Text
  replacementKmMin        Int?                     @map("replacement_km_min")
  replacementKmMax        Int?                     @map("replacement_km_max")
  replacementMonths       Int?                     @map("replacement_months")
  controlIntervalText     String?                  @map("control_interval_text") @db.Text
  analogText              String?                  @map("analog_text") @db.Text
  contextConfidence       String                   @default("page") @map("context_confidence")
  rawRequirementJson      Json                     @map("raw_requirement_json")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  mannLinks MannFluidRequirementLink[]

  @@index([importBatchId])
  @@index([sourceRowId])
  @@index([makeNormalized, modelNormalized])
  @@index([engineCodeNormalized])
  @@index([systemCode])
  @@index([yearFrom, yearTo])
  @@map("vehicle_fluid_requirements")
}

/// Кандидат или подтверждённая связь требования с MANN vehicleVariantKey.
/// Внешнего FK нет: один vehicleVariantKey повторяется в строках разных фильтров.
model MannFluidRequirementLink {
  id              String                  @id
  requirementId   String                  @map("requirement_id")
  requirement     VehicleFluidRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  mannVariantKey  String                  @map("mann_variant_key")
  mannMake        String                  @map("mann_make")
  mannModel       String                  @map("mann_model")
  mannVehicleText String?                 @map("mann_vehicle_text") @db.Text
  mannEngineCode  String?                 @map("mann_engine_code")
  matchScore      Int                     @map("match_score")
  confidence      String
  status          String                  @default("review_required")
  matchMethod     String                  @map("match_method")
  evidenceJson    Json                    @default("{}") @map("evidence_json")
  confirmedById   String?                 @map("confirmed_by_id")
  confirmedAt     DateTime?               @map("confirmed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@unique([requirementId, mannVariantKey])
  @@index([mannVariantKey, status])
  @@index([status, confidence])
  @@index([requirementId])
  @@map("mann_fluid_requirement_links")
}

