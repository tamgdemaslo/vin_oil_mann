/// Internal, employee-only assistant. These records intentionally do not
/// reuse the retired client-agent tables: no client conversation can become an
/// assistant thread by accident.
model AIAssistantThread {
  id             String   @id @default(cuid())
  branchId       String   @default("branch-main") @map("branch_id")
  organizationId String   @default("default") @map("organization_id")
  createdById    String   @map("created_by_id")
  title          String   @default("Новый разговор")
  status         String   @default("active")
  lastResponseId String?  @map("last_response_id")
  summary        String?  @db.Text
  lastMessageAt  DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages AIAssistantMessage[]
  runs     AIAssistantRun[]
  quotes   AIAssistantQuote[]

  @@index([organizationId, createdById, lastMessageAt])
  @@index([organizationId, status, lastMessageAt])
  @@map("ai_assistant_threads")
}

model AIAssistantMessage {
  id              String            @id @default(cuid())
  branchId        String            @default("branch-main") @map("branch_id")
  threadId        String            @map("thread_id")
  thread          AIAssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  organizationId  String            @default("default") @map("organization_id")
  role            String
  content         String            @db.Text
  citationsJson   Json              @default("[]") @map("citations_json")
  attachmentsJson Json              @default("[]") @map("attachments_json")
  runId           String?           @map("run_id")
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([threadId, createdAt])
  @@index([organizationId, createdAt])
  @@map("ai_assistant_messages")
}

