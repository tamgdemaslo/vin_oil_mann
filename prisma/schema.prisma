  @@unique([branchId, organizationId, sourceMessageId])
  @@index([organizationId, conversationId, createdAt])
  @@index([organizationId, idempotencyKey])
  @@index([status, createdAt])
  @@index([organizationId, conversationId, status, heartbeatAt])
  @@map("ai_agent_runs")
}

/// Операционный аудит выполнения запуска. Содержит только безопасные метаданные,
