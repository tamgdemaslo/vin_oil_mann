  payrollPeriodId          String?   @map("payroll_period_id")
  payrollPeriodFrom        String?   @map("payroll_period_from")
  payrollPeriodTo          String?   @map("payroll_period_to")
  moyskladId               String?   @map("moysklad_id")
  moyskladHref             String?   @map("moysklad_href") @db.Text
  moyskladMetaHref         String?   @map("moysklad_meta_href") @db.Text
