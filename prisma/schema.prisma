  closedAt     DateTime? @map("closed_at")
  closedBy     String?   @map("closed_by")
  closedByName String?   @map("closed_by_name")
  closedByRole String?   @map("closed_by_role")

  cashOrdersTotalCents   Int?    @map("cash_orders_total_cents")
  cardOrdersTotalCents   Int?    @map("card_orders_total_cents")
  withdrawalsTotalCents  Int?    @map("withdrawals_total_cents")
  cashExpensesTotalCents Int?    @map("cash_expenses_total_cents")
  expectedCashCents      Int?    @map("expected_cash_cents")
  actualCashCents        Int?    @map("actual_cash_cents")
  discrepancyCents       Int?    @map("discrepancy_cents")
