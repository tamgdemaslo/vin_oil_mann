// Смены, ставки, бонусы/штрафы. Пользователи — по логину из AUTH_USERS,
// а измененные пароли хранятся отдельно в БД.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shift {
  id                   String    @id @default(cuid())
  userLogin            String
  shiftDate            String // YYYY-MM-DD (локальный день смены)
  startedAt            DateTime  @map("started_at")
  endedAt              DateTime? @map("ended_at")
  closeType            String    @default("by_employee") @map("close_type") // by_employee | by_owner | auto
  closedByLogin        String?   @map("closed_by_login")
  latePenaltyCents     Int?      @map("late_penalty_cents")
  unclosedPenaltyCents Int?      @map("unclosed_penalty_cents")

  @@unique([userLogin, shiftDate])
  @@map("shifts")
}

model ShiftRate {
  id            String @id @default(cuid())
  userLogin     String @map("user_login")
  amountCents   Int    @map("amount_cents")
  effectiveFrom String @map("effective_from") // YYYY-MM-DD, новая ставка только на будущие смены

  @@map("shift_rates")
}

model PieceworkRule {
  id                 String   @id @default(cuid())
  targetType         String   @map("target_type") // service | product_group
  targetId           String   @map("target_id")
  targetName         String   @map("target_name")
  role               String
  mode               String // fixed | percent
  fixedCents         Int?     @map("fixed_cents")
  percentBasisPoints Int?     @map("percent_basis_points")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([targetType, targetId, role])
  @@map("piecework_rules")
}

model BonusPenalty {
  id             String   @id @default(cuid())
  userLogin      String   @map("user_login")
  date           String // YYYY-MM-DD
  amountCents    Int      @map("amount_cents") // бонус > 0, штраф < 0
  type           String // bonus | penalty_late | penalty_unclosed | penalty_manual
  comment        String?  @db.Text
  createdByLogin String   @map("created_by_login")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("bonus_penalties")
}

model PayrollAdjustment {
  id              String    @id @default(cuid())
  organizationId  String    @default("default") @map("organization_id")
  employeeId      String    @map("employee_id")
  payrollPeriodId String?   @map("payroll_period_id")
  periodFrom      String    @map("period_from")
  periodTo        String    @map("period_to")
  operationDate   String    @map("operation_date")
  type            String
  amountCents     Int       @map("amount_cents")
  reasonCode      String?   @map("reason_code")
  comment         String?   @db.Text
  sourceType      String?   @map("source_type")
  sourceId        String?   @map("source_id")
  status          String    @default("ACTIVE")
  createdById     String    @map("created_by_id")
  reversedById    String?   @map("reversed_by_id")
  reversalOfId    String?   @map("reversal_of_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  reversedAt      DateTime? @map("reversed_at")

  @@index([organizationId, employeeId])
  @@index([organizationId, periodFrom, periodTo])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([reversalOfId])
  @@map("payroll_adjustments")
}

model PayrollPayment {
  id              String    @id @default(cuid())
  organizationId  String    @default("default") @map("organization_id")
  employeeId      String    @map("employee_id")
  payrollPeriodId String?   @map("payroll_period_id")
  periodFrom      String    @map("period_from")
  periodTo        String    @map("period_to")
  operationDate   String    @map("operation_date")
  operationType   String    @default("SALARY") @map("operation_type")
  amountCents     Int       @map("amount_cents")
  paymentMethod   String    @map("payment_method")
  cashOrderId     String?   @map("cash_order_id")
  bankOperationId String?   @map("bank_operation_id")
  status          String    @default("ACTIVE")
  comment         String?   @db.Text
  createdById     String    @map("created_by_id")
  reversedById    String?   @map("reversed_by_id")
  reversalOfId    String?   @map("reversal_of_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  reversedAt      DateTime? @map("reversed_at")

  @@index([organizationId, employeeId])
  @@index([organizationId, periodFrom, periodTo])
  @@index([cashOrderId])
  @@index([status])
  @@index([reversalOfId])
  @@map("payroll_payments")
}

model ChangeLog {
  id               String   @id @default(cuid())
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  action           String // create | update | delete
  oldValue         Json?    @map("old_value")
  newValue         Json?    @map("new_value")
  performedByLogin String   @map("performed_by_login")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("change_logs")
}

// Назначенные владельцем рабочие дни сотрудника (график)
model ScheduledWorkingDay {
  id             String   @id @default(cuid())
  userLogin      String   @map("user_login")
  date           String // YYYY-MM-DD
  createdByLogin String   @map("created_by_login")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userLogin, date])
  @@map("scheduled_working_days")
}

model PayrollGoal {
  id             String   @id @default(cuid())
  organizationId String   @default("default") @map("organization_id")
  employeeLogin  String?  @map("employee_id")
  role           String?
  teamKey        String?  @map("team_key")
  periodType     String   @map("period_type") // SHIFT | WEEK | MONTH
  metric         String // ACCRUAL_AMOUNT | VEHICLES | SERVICES | PRODUCTS | SHIPMENTS | QUALITY | DIAGNOSTICS | APPROVED_RECOMMENDATIONS
  targetValue    Int      @map("target_value")
  baselineValue  Int?     @map("baseline_value")
  stretchValue   Int?     @map("stretch_value")
  startsAt       String   @map("starts_at")
  endsAt         String   @map("ends_at")
  status         String   @default("active")
  createdByLogin String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, employeeLogin])
  @@index([organizationId, role])
  @@index([organizationId, startsAt, endsAt])
  @@map("payroll_goals")
}

model PayrollAchievementDefinition {
  id             String   @id @default(cuid())
  organizationId String   @default("default") @map("organization_id")
  key            String
  title          String
  description    String   @db.Text
  icon           String?
  metric         String
  threshold      Int
  periodType     String   @map("period_type")
  enabled        Boolean  @default(true)
  repeatable     Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, key])
  @@map("payroll_achievement_definitions")
}

model PayrollAchievementAward {
  id             String    @id @default(cuid())
  organizationId String    @default("default") @map("organization_id")
  definitionId   String    @map("definition_id")
  employeeLogin  String    @map("employee_id")
  sourceId       String?   @map("source_id")
  awardedAt      DateTime  @default(now()) @map("awarded_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, employeeLogin])
  @@index([definitionId])
  @@map("payroll_achievement_awards")
}

model EmployeeRecognition {
  id             String   @id @default(cuid())
  organizationId String   @default("default") @map("organization_id")
  employeeLogin  String   @map("employee_id")
  authorLogin    String   @map("author_id")
  title          String
  message        String   @db.Text
  reason         String
  visibility     String   @default("PRIVATE") // PRIVATE | TEAM
  sourceType     String?  @map("source_type")
  sourceId       String?  @map("source_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, employeeLogin])
  @@index([organizationId, createdAt])
  @@map("employee_recognitions")
}

model PayrollTeamGoal {
  id              String   @id @default(cuid())
  organizationId  String   @default("default") @map("organization_id")
  teamKey         String   @map("team_key")
  employeeIdsJson Json     @map("employee_ids_json")
  metric          String
  targetValue     Int      @map("target_value")
  startsAt        String   @map("starts_at")
  endsAt          String   @map("ends_at")
  status          String   @default("active")
  createdByLogin  String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId, teamKey])
  @@index([organizationId, startsAt, endsAt])
  @@map("payroll_team_goals")
}

model EmployeeMotivationSettings {
  id                String   @id @default(cuid())
  organizationId    String   @default("default") @map("organization_id")
  employeeLogin     String?  @map("employee_id")
  showForecast      Boolean  @default(true) @map("show_forecast")
  showGoals         Boolean  @default(true) @map("show_goals")
  showAchievements  Boolean  @default(true) @map("show_achievements")
  showTeamProgress  Boolean  @default(true) @map("show_team_progress")
  showQuality       Boolean  @default(true) @map("show_quality")
  showRecognition   Boolean  @default(true) @map("show_recognition")
  notificationsJson Json     @default("{}") @map("notifications_json")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, employeeLogin])
  @@map("employee_motivation_settings")
}

model PayrollPeriod {
  id                  String   @id @default(cuid())
  organizationId      String   @default("default") @map("organization_id")
  dateFrom            String   @map("date_from")
  dateTo              String   @map("date_to")
  status              String   @default("closed")
  closedByLogin       String   @map("closed_by_login")
  closedAt            DateTime @default(now()) @map("closed_at")
  totalAccruedCents   Int      @map("total_accrued_cents")
  totalPaidCents      Int      @map("total_paid_cents")
  totalRemainingCents Int      @map("total_remaining_cents")
  employeesCount      Int      @map("employees_count")
  snapshotJson        Json     @map("snapshot_json")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, dateFrom, dateTo])
  @@index([organizationId, status])
  @@index([closedAt])
  @@map("payroll_periods")
}

model PayrollPeriodEmployee {
  id               String   @id @default(cuid())
  periodId         String   @map("period_id")
  employeeLogin    String   @map("employee_login")
  employeeName     String   @map("employee_name")
  employeeRole     String   @map("employee_role")
  shiftTotalCents  Int      @map("shift_total_cents")
  pieceworkCents   Int      @map("piecework_cents")
  adjustmentsCents Int      @map("adjustments_cents")
  paidOutCents     Int      @map("paid_out_cents")
  remainingCents   Int      @map("remaining_cents")
  totalCents       Int      @map("total_cents")
  shiftsCount      Int      @map("shifts_count")
  status           String   @default("closed")
  snapshotJson     Json     @map("snapshot_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([periodId, employeeLogin])
  @@index([employeeLogin])
  @@index([periodId])
  @@map("payroll_period_employees")
}

model PayrollAccrualLine {
  id               String   @id @default(cuid())
  periodId         String   @map("period_id")
  employeeLogin    String   @map("employee_login")
  lineType         String   @map("line_type")
  sourceType       String   @map("source_type")
  sourceId         String?  @map("source_id")
  reversalOfLineId String?  @map("reversal_of_line_id")
  date             String?
  title            String
  quantity         Decimal? @db.Decimal(12, 3)
  amountCents      Int      @map("amount_cents")
  status           String   @default("CONFIRMED")
  snapshotJson     Json?    @map("snapshot_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([periodId, employeeLogin])
  @@index([sourceType, sourceId])
  @@index([reversalOfLineId])
  @@map("payroll_accrual_lines")
}

model AuthPassword {
  login        String   @id
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("auth_passwords")
}

/// Слепок отгрузок МойСклад для аналитики по клиентам (только applicable)
model MoySkladDemandSync {
  id                String   @id
  documentDate      String   @map("document_date")
  momentAt          DateTime @map("moment_at")
  applicable        Boolean
  sumCents          Int      @map("sum_cents")
  name              String
  agentMetaHref     String?  @map("agent_meta_href")
  agentNameSnapshot String?  @map("agent_name_snapshot")
  phonesRaw         Json?    @map("phones_raw")
  normalizedPhone   String?  @map("normalized_phone")
  hasIncompleteCost Boolean  @default(false) @map("has_incomplete_cost")
  positionCount     Int      @default(0) @map("position_count")
  /**
   * Прибыль по строкам документа (копейки), считается при синхронизации
   */
  profitCents       Int      @default(0) @map("profit_cents")
  /**
   * Услуги в документе по порядку первого вхождения: [{ "id", "name" }]
   */
  documentServices  Json?    @map("document_services")
  syncedAt          DateTime @default(now()) @map("synced_at")

  positions MoySkladDemandPositionSync[]

  @@index([normalizedPhone])
  @@index([documentDate])
  @@index([momentAt])
  @@map("moysklad_demand_sync")
}

/// Позиции отгрузки для сегментации по услугам и расчёта себестоимости
model MoySkladDemandPositionSync {
  id                   String             @id
  demandId             String             @map("demand_id")
  demand               MoySkladDemandSync @relation(fields: [demandId], references: [id], onDelete: Cascade)
  assortmentType       String             @map("assortment_type")
  assortmentId         String?            @map("assortment_id")
  name                 String
  quantity             Float
  priceCentsPerUnit    Int                @map("price_cents_per_unit")
  discount             Float              @default(0)
  buyPriceCentsPerUnit Int?               @map("buy_price_cents_per_unit")
  lineIncompleteCost   Boolean            @default(false) @map("line_incomplete_cost")

  @@index([demandId])
  @@index([assortmentType, assortmentId])
  @@map("moysklad_demand_position_sync")
}

/// Состояние синхронизации (одна строка)
model MoySkladAnalyticsSyncState {
  id                   String    @id
  updatedAt            DateTime  @updatedAt @map("updated_at")
  lastSyncedAt         DateTime? @map("last_synced_at")
  lastError            String?   @map("last_error") @db.Text
  demandsSynced        Int       @default(0) @map("demands_synced")
  syncRunning          Boolean   @default(false) @map("sync_running")
  syncMode             String?   @map("sync_mode")
  syncPhase            String?   @map("sync_phase")
  syncStartedAt        DateTime? @map("sync_started_at")
  syncFinishedAt       DateTime? @map("sync_finished_at")
  syncHeartbeatAt      DateTime? @map("sync_heartbeat_at")
  syncTotalDemands     Int?      @map("sync_total_demands")
  syncProcessedDemands Int       @default(0) @map("sync_processed_demands")
  syncScannedDemands   Int       @default(0) @map("sync_scanned_demands")
  syncLastDemandId     String?   @map("sync_last_demand_id")
  syncLastDemandName   String?   @map("sync_last_demand_name")
  syncMessage          String?   @map("sync_message") @db.Text

  @@map("moysklad_analytics_sync_state")
}

/// Пороги статусов аналитики (singleton id = default)
model CustomerAnalyticsSettings {
  id                    String @id @default("default")
  inactiveDaysThreshold Int    @default(90) @map("inactive_days_threshold")
  regularVisitThreshold Int    @default(3) @map("regular_visit_threshold")
  vipThresholdCents     Int?   @map("vip_threshold_cents")
  vipMetric             String @default("revenue") @map("vip_metric")
  vipWindow             String @default("all") @map("vip_window")

  @@map("customer_analytics_settings")
}

model VinLookupCache {
  vin       String   @id @db.Text
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt], map: "vin_lookup_cache_expires_at_idx")
  @@map("vin_lookup_cache")
}

model CrmStage {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @map("sort_order")
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deals CrmDeal[]

  @@unique([sortOrder])
  @@map("crm_stages")
}

model CrmDeal {
  id                       String    @id @default(cuid())
  title                    String
  customerName             String?   @map("customer_name")
  phoneNormalized          String?   @map("phone_normalized")
  vehicle                  String?
  source                   String?
  amountCents              Int?      @map("amount_cents")
  clientType               String?   @map("client_type")
  nextAction               String?   @map("next_action")
  stageId                  String    @map("stage_id")
  responsibleLogin         String?   @map("responsible_login")
  moyskladCounterpartyId   String?   @map("moysklad_counterparty_id")
  moyskladCounterpartyName String?   @map("moysklad_counterparty_name")
  moyskladCounterpartyHref String?   @map("moysklad_counterparty_href") @db.Text
  yclientsRecordId         String?   @map("yclients_record_id")
  moyskladDemandId         String?   @map("moysklad_demand_id")
  suppliesNote             String?   @map("supplies_note") @db.Text
  suppliesSupplier         String?   @map("supplies_supplier")
  suppliesExpectedAt       DateTime? @map("supplies_expected_at")
  nextContactAt            DateTime? @map("next_contact_at")
  snoozeUntil              DateTime? @map("snooze_until")
  status                   String    @default("open") // open | won | lost
  closeReason              String?   @map("close_reason")
  notes                    String?   @db.Text
  createdByLogin           String    @map("created_by_login")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  stage CrmStage @relation(fields: [stageId], references: [id])

  notificationLogs ClientCaseNotificationLog[]

  @@index([phoneNormalized])
  @@index([moyskladCounterpartyId])
  @@index([clientType])
  @@index([nextContactAt])
  @@index([snoozeUntil])
  @@index([stageId])
  @@index([status])
  @@map("crm_deals")
}

model ClientCaseNotificationLog {
  id             String    @id @default(cuid())
  caseId         String    @map("case_id")
  userId         String    @map("user_id")
  type           String
  channel        String
  sentAt         DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  snoozedUntil   DateTime? @map("snoozed_until") @db.Timestamptz(6)
  status         String    @default("sent")
  errorMessage   String?   @map("error_message") @db.Text

  case CrmDeal @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, userId, type, channel, sentAt], map: "client_case_notification_log_dedupe_idx")
  @@index([userId, acknowledgedAt, sentAt], map: "client_case_notification_log_user_feed_idx")
  @@map("client_case_notification_log")
}

// --- Messenger Gateway ---

model MessengerConnection {
  id               String    @id
  organizationId   String    @default("default") @map("organization_id")
  channel          String
  type             String    @default("unknown")
  clientId         String?   @map("client_id")
  employeeId       String?   @map("employee_id")
  supplierId       String?   @map("supplier_id")
  externalUserId   String?   @map("external_user_id")
  externalChatId   String    @map("external_chat_id")
  externalUsername String?   @map("external_username")
  displayName      String    @map("display_name")
  phone            String?
  avatarUrl        String?   @map("avatar_url") @db.Text
  isActive         Boolean   @default(true) @map("is_active")
  linkedAt         DateTime? @map("linked_at") @db.Timestamptz(6)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(6)
  blockedAt        DateTime? @map("blocked_at") @db.Timestamptz(6)
  rawJson          Json?     @map("raw_json")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversations MessengerConversation[]
  outbox        MessengerOutbox[]

  @@unique([channel, externalChatId])
  @@index([organizationId, channel])
  @@index([channel, externalUserId])
  @@index([channel])
  @@index([type])
  @@index([clientId])
  @@index([employeeId])
  @@index([supplierId])
  @@index([isActive])
  @@map("messenger_connections")
}

model MessengerAccount {
  id                String    @id
  organizationId    String    @default("default") @map("organization_id")
  channel           String
  mode              String
  externalAccountId String?   @map("external_account_id")
  displayName       String    @default("") @map("display_name")
  phone             String?
  username          String?
  avatarUrl         String?   @map("avatar_url") @db.Text
  isActive          Boolean   @default(true) @map("is_active")
  isDefault         Boolean   @default(false) @map("is_default")
  enabled           Boolean   @default(true)
  status            String    @default("disconnected")
  connectedByUserId String?   @map("connected_by_user_id")
  connectedAt       DateTime? @map("connected_at") @db.Timestamptz(6)
  disconnectedAt    DateTime? @map("disconnected_at") @db.Timestamptz(6)
  lastInboundAt     DateTime? @map("last_inbound_at") @db.Timestamptz(6)
  lastOutboundAt    DateTime? @map("last_outbound_at") @db.Timestamptz(6)
  lastSyncAt        DateTime? @map("last_sync_at") @db.Timestamptz(6)
  errorCode         String?   @map("error_code")
  errorMessage      String?   @map("error_message") @db.Text
  metadataJson      Json      @default("{}") @map("metadata_json")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  telegramUserSessions TelegramUserSession[]
  conversations        MessengerConversation[]
  messages             MessengerMessage[]
  outbox               MessengerOutbox[]
  credentials          IntegrationCredential[]
  onboardingSessions   IntegrationOnboardingSession[]
  webhookSubscriptions WebhookSubscription[]
  syncCursors          MessengerSyncCursor[]

  @@index([organizationId, channel, mode, status])
  @@index([channel, mode])
  @@index([status])
  @@map("messenger_accounts")
}

model TelegramUserSession {
  id                     String    @id
  organizationId         String    @default("default") @map("organization_id")
  messengerAccountId     String    @map("messenger_account_id")
  phone                  String
  apiIdEncrypted         Json?     @map("api_id_encrypted")
  apiHashEncrypted       Json?     @map("api_hash_encrypted")
  sessionEncrypted       Json?     @map("session_encrypted")
  phoneCodeHashEncrypted Json?     @map("phone_code_hash_encrypted")
  qrTokenEncrypted       Json?     @map("qr_token_encrypted")
  qrExpiresAt            DateTime? @map("qr_expires_at") @db.Timestamptz(6)
  authAttemptId          String?   @map("auth_attempt_id")
  authDcId               String?   @map("auth_dc_id")
  authDeliveryType       String?   @map("auth_delivery_type")
  authNextType           String?   @map("auth_next_type")
  authTimeout            Int?      @map("auth_timeout")
  authExpiresAt          DateTime? @map("auth_expires_at") @db.Timestamptz(6)
  status                 String    @default("disconnected")
