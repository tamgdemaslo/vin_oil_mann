// --- Новая карта диагностики ---

enum DiagnosticMapSessionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum DiagnosticMapItemStatus {
  UNCHECKED
  NORMAL
  ATTENTION
  REPLACE
  NO_ACCESS
  BY_MILEAGE
  BY_CLIENT
  SKIPPED
  NOT_APPLICABLE
}

enum DiagnosticMapCheckMethod {
  INSPECTION
  CLIENT_WORDS
  MILEAGE
  NO_ACCESS
  SKIPPED
}

enum DiagnosticMapApplicability {
  APPLICABLE
  NOT_APPLICABLE
  HIDDEN
}

enum DiagnosticMapActionKind {
  ADD_TO_SHIPMENT
  CREATE_CRM_TASK
  NEXT_VISIT
  SHOW_IN_REPORT
}

model DiagnosticMapSession {
  id       String       @id @default(cuid())
  branchId String       @default("branch-main") @map("branch_id")
  demandId String?      @map("demand_id")
  demand   LocalDemand? @relation(fields: [branchId, demandId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)

  clientId    String? @map("client_id")
  clientName  String? @map("client_name")
  clientPhone String? @map("client_phone")

  vin          String?
  brand        String?
  model        String?
  year         Int?
  licensePlate String? @map("license_plate")
  mileage      Int?
  vehicleHints Json?   @map("vehicle_hints")

  masterLogin String? @map("master_login")
  masterName  String? @map("master_name")

  status              DiagnosticMapSessionStatus @default(IN_PROGRESS)
  publicToken         String                     @unique @default(cuid()) @map("public_token")
  startedAt           DateTime                   @default(now()) @map("started_at")
  completedAt         DateTime?                  @map("completed_at")
  reportSentAt        DateTime?                  @map("report_sent_at")
  clientWantsReminder Boolean                    @default(true) @map("client_wants_reminder")

  totalCount                   Int @default(0) @map("total_count")
  normalCount                  Int @default(0) @map("normal_count")
  attentionCount               Int @default(0) @map("attention_count")
  replaceCount                 Int @default(0) @map("replace_count")
  indirectCount                Int @default(0) @map("indirect_count")
  noAccessCount                Int @default(0) @map("no_access_count")
  byMileageCount               Int @default(0) @map("by_mileage_count")
  byClientCount                Int @default(0) @map("by_client_count")
  withPhotoCount               Int @default(0) @map("with_photo_count")
  withoutPhotoCount            Int @default(0) @map("without_photo_count")
  nowRecommendationCount       Int @default(0) @map("now_recommendation_count")
  nextVisitRecommendationCount Int @default(0) @map("next_visit_recommendation_count")

  items        DiagnosticMapItem[]
  vehiclePhoto DiagnosticMapVehiclePhoto?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([demandId])
  @@index([clientId])
  @@index([vin])
  @@index([status])
  @@unique([branchId, id])
  @@map("diagnostic_map_sessions")
}

model DiagnosticMapItem {
  id        String               @id @default(cuid())
  branchId  String               @default("branch-main") @map("branch_id")
  sessionId String               @map("session_id")
  session   DiagnosticMapSession @relation(fields: [branchId, sessionId], references: [branchId, id], onDelete: Cascade, onUpdate: Cascade)

  blockCode       String @map("block_code")
  blockTitle      String @map("block_title")
  blockOrder      Int    @map("block_order")
  itemCode        String @map("item_code")
  itemTitle       String @map("item_title")
  itemOrder       Int    @map("item_order")
  catalogSnapshot Json   @map("catalog_snapshot")

  applicability DiagnosticMapApplicability @default(APPLICABLE)
  status        DiagnosticMapItemStatus    @default(UNCHECKED)
  checkMethod   DiagnosticMapCheckMethod   @default(INSPECTION) @map("check_method")

  value          String?
  comment        String? @db.Text
  recommendation String? @db.Text
  nextVisit      Boolean @default(false) @map("next_visit")
  showInReport   Boolean @default(true) @map("show_in_report")

  selectedNotes           String[] @map("selected_notes")
  selectedRecommendations String[] @map("selected_recommendations")

  photos  DiagnosticMapPhoto[]
  actions DiagnosticMapRecommendationAction[]

