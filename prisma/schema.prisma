// Смены, ставки, бонусы/штрафы. Пользователи — по логину из AUTH_USERS,
// а измененные пароли хранятся отдельно в БД.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Филиальная архитектура ---

model BusinessGroup {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches               Branch[]
  memberships            BusinessGroupMembership[]
  integrationCredentials IntegrationCredential[]

  @@index([status])
  @@map("business_groups")
}

/// Глобальная учётная запись. На переходном этапе login синхронизируется с AUTH_USERS.
model User {
  id                 String   @id @default(cuid())
  login              String   @unique
  name               String
  authRole           String   @default("admin") @map("auth_role")
  status             String   @default("active")
  lastActiveBranchId String?  @map("last_active_branch_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  branchMemberships BranchMembership[]
  groupMemberships  BusinessGroupMembership[]

  @@index([status])
  @@map("users")
}

model Branch {
  id                   String        @id @default(cuid())
  businessGroupId      String        @map("business_group_id")
  businessGroup        BusinessGroup @relation(fields: [businessGroupId], references: [id], onDelete: Restrict)
  name                 String
  shortName            String        @map("short_name")
  slug                 String
  status               String        @default("active")
  address              String?       @db.Text
  timezone             String        @default("Europe/Kaliningrad")
  phone                String?
  email                String?
  telegramUsername     String?       @map("telegram_username")
  legalEntityName      String?       @map("legal_entity_name")
  legalEntityType      String?       @map("legal_entity_type")
  inn                  String?
  ogrn                 String?
  bankDetailsJson      Json?         @map("bank_details_json")
  openingDate          DateTime?     @map("opening_date") @db.Date
  legacyOrganizationId String?       @unique @map("legacy_organization_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  memberships            BranchMembership[]
  legalEntities          BranchLegalEntity[]
  communication          BranchCommunicationSettings?
  telegramIntegration    BranchTelegramIntegration?
  stockTransfersOut      BranchStockTransfer[]        @relation("StockTransferSource")
  stockTransfersIn       BranchStockTransfer[]        @relation("StockTransferDestination")
  integrationCredentials IntegrationCredential[]

  @@unique([businessGroupId, slug])
  @@index([businessGroupId, status])
  @@map("branches")
}

model BranchMembership {
  id              String    @id @default(cuid())
  branchId        String    @map("branch_id")
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId          String    @map("role_id")
  status          String    @default("active")
  isDefaultBranch Boolean   @default(false) @map("is_default_branch")
  position        String?
  employmentStart DateTime? @map("employment_start") @db.Date
  paySettingsJson Json?     @map("pay_settings_json")
  scheduleJson    Json?     @map("schedule_json")
  permissionsJson Json?     @map("permissions_json")
  joinedAt        DateTime  @default(now()) @map("joined_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([branchId, userId])
  @@index([userId, status])
  @@index([branchId, status])
  @@map("branch_memberships")
}

model BusinessGroupMembership {
  id              String        @id @default(cuid())
  businessGroupId String        @map("business_group_id")
  businessGroup   BusinessGroup @relation(fields: [businessGroupId], references: [id], onDelete: Cascade)
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            String
  status          String        @default("active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([businessGroupId, userId])
  @@index([userId, status])
  @@map("business_group_memberships")
}

model BranchLegalEntity {
  id                   String   @id @default(cuid())
  branchId             String   @map("branch_id")
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name                 String
  entityType           String   @map("entity_type")
  inn                  String?
  kpp                  String?
  ogrn                 String?
  ogrnip               String?
  legalAddress         String?  @map("legal_address") @db.Text
  bankDetailsJson      Json?    @map("bank_details_json")
  documentSettingsJson Json?    @map("document_settings_json")
  isPrimary            Boolean  @default(false) @map("is_primary")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([branchId, inn])
  @@index([branchId, isPrimary])
  @@map("branch_legal_entities")
}

model BranchCommunicationSettings {
  id                   String   @id @default(cuid())
  branchId             String   @unique @map("branch_id")
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  primaryPhone         String   @map("primary_phone")
  secondaryPhone       String?  @map("secondary_phone")
  whatsapp             String?
  telegram             String?
  email                String?
  callbackSettingsJson Json?    @map("callback_settings_json")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("branch_communication_settings")
}

model BranchTelegramIntegration {
  id                String    @id @default(cuid())
  branchId          String    @unique @map("branch_id")
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  phoneNumberMasked String?   @map("phone_number_masked")
  sessionEncrypted  String?   @map("session_encrypted") @db.Text
  status            String    @default("disconnected")
  telegramUserId    String?   @map("telegram_user_id")
  telegramUsername  String?   @map("telegram_username")
  connectedAt       DateTime? @map("connected_at")
  lastSyncAt        DateTime? @map("last_sync_at")
  errorCode         String?   @map("error_code")
  settingsJson      Json?     @map("settings_json")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("branch_telegram_integrations")
}

model BranchAuditLog {
  id              String   @id @default(cuid())
  businessGroupId String?  @map("business_group_id")
  branchId        String?  @map("branch_id")
  userId          String?  @map("user_id")
  action          String
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([businessGroupId, createdAt])
  @@index([branchId, createdAt])
  @@index([userId, createdAt])
  @@map("branch_audit_logs")
}

model BranchStockTransfer {
  id                  String    @id @default(cuid())
  sourceBranchId      String    @map("source_branch_id")
  sourceBranch        Branch    @relation("StockTransferSource", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranchId String    @map("destination_branch_id")
  destinationBranch   Branch    @relation("StockTransferDestination", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  status              String    @default("draft")
  createdById         String    @map("created_by_id")
  approvedById        String?   @map("approved_by_id")
  shippedAt           DateTime? @map("shipped_at")
  receivedAt          DateTime? @map("received_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  items BranchStockTransferItem[]

  @@index([sourceBranchId, status])
  @@index([destinationBranchId, status])
  @@map("branch_stock_transfers")
}

model BranchStockTransferItem {
  id         String              @id @default(cuid())
  transferId String              @map("transfer_id")
  transfer   BranchStockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String              @map("product_id")
  quantity   Decimal             @db.Decimal(14, 3)
  metadata   Json?

  @@index([transferId])
  @@map("branch_stock_transfer_items")
}

model Shift {
  id                   String    @id @default(cuid())
  branchId             String    @default("branch-main") @map("branch_id")
  userLogin            String
  shiftDate            String // YYYY-MM-DD (локальный день смены)
  startedAt            DateTime  @map("started_at")
  endedAt              DateTime? @map("ended_at")
  closeType            String    @default("by_employee") @map("close_type") // by_employee | by_owner | auto
  closedByLogin        String?   @map("closed_by_login")
  latePenaltyCents     Int?      @map("late_penalty_cents")
  unclosedPenaltyCents Int?      @map("unclosed_penalty_cents")

  @@unique([branchId, userLogin, shiftDate])
  @@index([branchId, startedAt])
  @@map("shifts")
}

model ShiftRate {
  id            String @id @default(cuid())
  branchId      String @default("branch-main") @map("branch_id")
  userLogin     String @map("user_login")
  amountCents   Int    @map("amount_cents")
  effectiveFrom String @map("effective_from") // YYYY-MM-DD, новая ставка только на будущие смены

  @@index([branchId, userLogin])
  @@map("shift_rates")
}

model PieceworkRule {
  id                 String   @id @default(cuid())
  branchId           String   @default("branch-main") @map("branch_id")
  targetType         String   @map("target_type") // service | product_group
  targetId           String   @map("target_id")
  targetName         String   @map("target_name")
  role               String
  mode               String // fixed | percent
  fixedCents         Int?     @map("fixed_cents")
  percentBasisPoints Int?     @map("percent_basis_points")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([branchId, targetType, targetId, role])
  @@map("piecework_rules")
}

model BonusPenalty {
  id             String   @id @default(cuid())
  branchId       String   @default("branch-main") @map("branch_id")
  userLogin      String   @map("user_login")
  date           String // YYYY-MM-DD
  amountCents    Int      @map("amount_cents") // бонус > 0, штраф < 0
  type           String // bonus | penalty_late | penalty_unclosed | penalty_manual
  comment        String?  @db.Text
  createdByLogin String   @map("created_by_login")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([branchId, userLogin, date])
  @@map("bonus_penalties")
}

model PayrollAdjustment {
  id              String    @id @default(cuid())
  branchId        String    @default("branch-main") @map("branch_id")
  organizationId  String    @default("default") @map("organization_id")
  employeeId      String    @map("employee_id")
  payrollPeriodId String?   @map("payroll_period_id")
  periodFrom      String    @map("period_from")
  periodTo        String    @map("period_to")
  operationDate   String    @map("operation_date")
  type            String
  amountCents     Int       @map("amount_cents")
  reasonCode      String?   @map("reason_code")
  comment         String?   @db.Text
  sourceType      String?   @map("source_type")
  sourceId        String?   @map("source_id")
  status          String    @default("ACTIVE")
  createdById     String    @map("created_by_id")
  reversedById    String?   @map("reversed_by_id")
  reversalOfId    String?   @map("reversal_of_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  reversedAt      DateTime? @map("reversed_at")

  @@index([branchId, employeeId])
  @@index([organizationId, employeeId])
  @@index([organizationId, periodFrom, periodTo])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([reversalOfId])
  @@map("payroll_adjustments")
}

model PayrollPayment {
  id              String    @id @default(cuid())
  branchId        String    @default("branch-main") @map("branch_id")
  organizationId  String    @default("default") @map("organization_id")
  employeeId      String    @map("employee_id")
  payrollPeriodId String?   @map("payroll_period_id")
  periodFrom      String    @map("period_from")
  periodTo        String    @map("period_to")
  operationDate   String    @map("operation_date")
  operationType   String    @default("SALARY") @map("operation_type")
  amountCents     Int       @map("amount_cents")
  paymentMethod   String    @map("payment_method")
  cashOrderId     String?   @map("cash_order_id")
  bankOperationId String?   @map("bank_operation_id")
  status          String    @default("ACTIVE")
  comment         String?   @db.Text
  createdById     String    @map("created_by_id")
  reversedById    String?   @map("reversed_by_id")
  reversalOfId    String?   @map("reversal_of_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  reversedAt      DateTime? @map("reversed_at")

  @@index([branchId, employeeId])
  @@index([organizationId, employeeId])
  @@index([organizationId, periodFrom, periodTo])
  @@index([cashOrderId])
  @@index([status])
  @@index([reversalOfId])
  @@map("payroll_payments")
}

model ChangeLog {
  id               String   @id @default(cuid())
  branchId         String   @default("branch-main") @map("branch_id")
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  action           String // create | update | delete
  oldValue         Json?    @map("old_value")
  newValue         Json?    @map("new_value")
  performedByLogin String   @map("performed_by_login")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([branchId, createdAt])
  @@map("change_logs")
}

// Назначенные владельцем рабочие дни сотрудника (график)
model ScheduledWorkingDay {
  id             String   @id @default(cuid())
  branchId       String   @default("branch-main") @map("branch_id")
  userLogin      String   @map("user_login")
  date           String // YYYY-MM-DD
  createdByLogin String   @map("created_by_login")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([branchId, userLogin, date])
  @@map("scheduled_working_days")
}

model PayrollGoal {
  id             String   @id @default(cuid())
  branchId       String   @default("branch-main") @map("branch_id")
  organizationId String   @default("default") @map("organization_id")
  employeeLogin  String?  @map("employee_id")
  role           String?
  teamKey        String?  @map("team_key")
  periodType     String   @map("period_type") // SHIFT | WEEK | MONTH
  metric         String // ACCRUAL_AMOUNT | VEHICLES | SERVICES | PRODUCTS | SHIPMENTS | QUALITY | DIAGNOSTICS | APPROVED_RECOMMENDATIONS
  targetValue    Int      @map("target_value")
  baselineValue  Int?     @map("baseline_value")
  stretchValue   Int?     @map("stretch_value")
  startsAt       String   @map("starts_at")
  endsAt         String   @map("ends_at")
  status         String   @default("active")
  createdByLogin String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, employeeLogin])
  @@index([organizationId, role])
  @@index([organizationId, startsAt, endsAt])
  @@map("payroll_goals")
}

model PayrollAchievementDefinition {
  id             String   @id @default(cuid())
  branchId       String   @default("branch-main") @map("branch_id")
  organizationId String   @default("default") @map("organization_id")
  key            String
  title          String
  description    String   @db.Text
  icon           String?
  metric         String
  threshold      Int
  periodType     String   @map("period_type")
  enabled        Boolean  @default(true)
  repeatable     Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([branchId, key])
  @@index([organizationId, key])
  @@map("payroll_achievement_definitions")
}

model PayrollAchievementAward {
  id             String    @id @default(cuid())
  branchId       String    @default("branch-main") @map("branch_id")
  organizationId String    @default("default") @map("organization_id")
  definitionId   String    @map("definition_id")
  employeeLogin  String    @map("employee_id")
  sourceId       String?   @map("source_id")
  awardedAt      DateTime  @default(now()) @map("awarded_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, employeeLogin])
  @@index([definitionId])
  @@map("payroll_achievement_awards")
}

model EmployeeRecognition {
  id             String   @id @default(cuid())
  branchId       String   @default("branch-main") @map("branch_id")
  organizationId String   @default("default") @map("organization_id")
  employeeLogin  String   @map("employee_id")
  authorLogin    String   @map("author_id")
  title          String
  message        String   @db.Text
  reason         String
  visibility     String   @default("PRIVATE") // PRIVATE | TEAM
  sourceType     String?  @map("source_type")
  sourceId       String?  @map("source_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, employeeLogin])
  @@index([organizationId, createdAt])
  @@map("employee_recognitions")
}

model PayrollTeamGoal {
  id              String   @id @default(cuid())
  branchId        String   @default("branch-main") @map("branch_id")
  organizationId  String   @default("default") @map("organization_id")
  teamKey         String   @map("team_key")
  employeeIdsJson Json     @map("employee_ids_json")
  metric          String
  targetValue     Int      @map("target_value")
  startsAt        String   @map("starts_at")
  endsAt          String   @map("ends_at")
  status          String   @default("active")
  createdByLogin  String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([organizationId, teamKey])
  @@index([organizationId, startsAt, endsAt])
  @@map("payroll_team_goals")
}

model EmployeeMotivationSettings {
  id                String   @id @default(cuid())
  branchId          String   @default("branch-main") @map("branch_id")
  organizationId    String   @default("default") @map("organization_id")
  employeeLogin     String?  @map("employee_id")
  showForecast      Boolean  @default(true) @map("show_forecast")
  showGoals         Boolean  @default(true) @map("show_goals")
  showAchievements  Boolean  @default(true) @map("show_achievements")
  showTeamProgress  Boolean  @default(true) @map("show_team_progress")
  showQuality       Boolean  @default(true) @map("show_quality")
  showRecognition   Boolean  @default(true) @map("show_recognition")
  notificationsJson Json     @default("{}") @map("notifications_json")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([branchId, employeeLogin])
  @@index([organizationId, employeeLogin])
  @@map("employee_motivation_settings")
}

model PayrollPeriod {
  id                  String   @id @default(cuid())
  branchId            String   @default("branch-main") @map("branch_id")
  organizationId      String   @default("default") @map("organization_id")
  dateFrom            String   @map("date_from")
  dateTo              String   @map("date_to")
  status              String   @default("closed")
  closedByLogin       String   @map("closed_by_login")
  closedAt            DateTime @default(now()) @map("closed_at")
  totalAccruedCents   Int      @map("total_accrued_cents")
  totalPaidCents      Int      @map("total_paid_cents")
  totalRemainingCents Int      @map("total_remaining_cents")
  employeesCount      Int      @map("employees_count")
  snapshotJson        Json     @map("snapshot_json")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  employees    PayrollPeriodEmployee[]
  accrualLines PayrollAccrualLine[]

  @@unique([branchId, dateFrom, dateTo])
  @@unique([branchId, id])
  @@index([organizationId, dateFrom, dateTo])
  @@index([organizationId, status])
  @@index([closedAt])
  @@map("payroll_periods")
}

model PayrollPeriodEmployee {
  id               String   @id @default(cuid())
  branchId         String   @default("branch-main") @map("branch_id")
  periodId         String   @map("period_id")
  period           PayrollPeriod @relation(fields: [branchId, periodId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  employeeLogin    String   @map("employee_login")
  employeeName     String   @map("employee_name")
  employeeRole     String   @map("employee_role")
  shiftTotalCents  Int      @map("shift_total_cents")
  pieceworkCents   Int      @map("piecework_cents")
  adjustmentsCents Int      @map("adjustments_cents")
  paidOutCents     Int      @map("paid_out_cents")
  remainingCents   Int      @map("remaining_cents")
  totalCents       Int      @map("total_cents")
  shiftsCount      Int      @map("shifts_count")
  status           String   @default("closed")
  snapshotJson     Json     @map("snapshot_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([branchId, periodId, employeeLogin])
  @@index([employeeLogin])
  @@index([periodId])
  @@map("payroll_period_employees")
}

model PayrollAccrualLine {
  id               String   @id @default(cuid())
  branchId         String   @default("branch-main") @map("branch_id")
  periodId         String   @map("period_id")
  period           PayrollPeriod @relation(fields: [branchId, periodId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  employeeLogin    String   @map("employee_login")
  lineType         String   @map("line_type")
  sourceType       String   @map("source_type")
  sourceId         String?  @map("source_id")
  reversalOfLineId String?  @map("reversal_of_line_id")
  date             String?
  title            String
  quantity         Decimal? @db.Decimal(12, 3)
  amountCents      Int      @map("amount_cents")
  status           String   @default("CONFIRMED")
  snapshotJson     Json?    @map("snapshot_json")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([periodId, employeeLogin])
  @@index([sourceType, sourceId])
  @@index([reversalOfLineId])
  @@map("payroll_accrual_lines")
}

model AuthPassword {
  login        String   @id
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("auth_passwords")
}

/// Слепок отгрузок МойСклад для аналитики по клиентам (только applicable)
model MoySkladDemandSync {
  branchId          String   @default("branch-main") @map("branch_id")
  id                String   @id
  documentDate      String   @map("document_date")
  momentAt          DateTime @map("moment_at")
  applicable        Boolean
  sumCents          Int      @map("sum_cents")
  name              String
  agentMetaHref     String?  @map("agent_meta_href")
  agentNameSnapshot String?  @map("agent_name_snapshot")
  phonesRaw         Json?    @map("phones_raw")
  normalizedPhone   String?  @map("normalized_phone")
  hasIncompleteCost Boolean  @default(false) @map("has_incomplete_cost")
  positionCount     Int      @default(0) @map("position_count")
  /**
   * Прибыль по строкам документа (копейки), считается при синхронизации
   */
  profitCents       Int      @default(0) @map("profit_cents")
  /**
   * Услуги в документе по порядку первого вхождения: [{ "id", "name" }]
   */
  documentServices  Json?    @map("document_services")
  syncedAt          DateTime @default(now()) @map("synced_at")

  positions MoySkladDemandPositionSync[]

  @@index([normalizedPhone])
  @@index([documentDate])
  @@index([momentAt])
  @@index([branchId])
  @@map("moysklad_demand_sync")
}

/// Позиции отгрузки для сегментации по услугам и расчёта себестоимости
model MoySkladDemandPositionSync {
  branchId             String             @default("branch-main") @map("branch_id")
  id                   String             @id
