  sourceUrl       String                   @map("source_url") @db.Text
  pagePath        String?                  @map("page_path") @db.Text
  pageTitle       String?                  @map("page_title") @db.Text
  makeRaw         String?                  @map("make_raw")
  makeNormalized  String?                  @map("make_normalized")
  modelRaw        String?                  @map("model_raw")
  modelNormalized String?                  @map("model_normalized")
  generationRaw   String?                  @map("generation_raw")
  tableIndex      Int                      @map("table_index")
  rowIndex        Int                      @map("row_index")
  tableKind       String?                  @map("table_kind")
  applicationRaw  String?                  @map("application_raw") @db.Text
  systemNameRaw   String?                  @map("system_name_raw") @db.Text
  rawCellsJson    Json                     @map("raw_cells_json")
  parsedRowJson   Json                     @map("parsed_row_json")
  sourceFetchedAt DateTime?                @map("source_fetched_at") @db.Timestamptz(6)
  sourcePageHash  String?                  @map("source_page_hash")
  importedAt      DateTime                 @default(now()) @map("imported_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
