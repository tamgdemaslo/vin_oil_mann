/// Версия внешнего каталога технических жидкостей. Старые пакеты остаются в аудите,
/// а актуальные строки при повторном импорте заменяются атомарно.
model FluidCatalogImportBatch {
  id           String    @id @default(cuid())
  status       String    @default("imported")
  sourceName   String    @map("source_name")
  sourceUrl    String?   @map("source_url") @db.Text
  sourceFile   String?   @map("source_file") @db.Text
  sourceHash   String    @map("source_hash")
  summaryJson  Json?     @map("summary_json")
  statsJson    Json      @default("{}") @map("stats_json")
  errorsJson   Json      @default("[]") @map("errors_json")
  importedById String?   @map("imported_by_id")
  importedAt   DateTime  @default(now()) @map("imported_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  sourceRows   FluidSourceRow[]
  requirements VehicleFluidRequirement[]

  @@index([sourceName, importedAt])
  @@index([sourceHash])
  @@index([status])
  @@map("fluid_catalog_import_batches")
}

/// Потеребезопасная копия одной опубликованной строки источника.
model FluidSourceRow {
  id              String                   @id
  importBatchId   String?                  @map("import_batch_id")
