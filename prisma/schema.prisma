  counterparty      LocalCounterparty? @relation(fields: [branchId, counterpartyId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  agentMoyskladId   String?            @map("agent_moysklad_id")
  agentNameSnapshot String?            @map("agent_name_snapshot")

  storeId           String?            @map("store_id")
  store             LocalStore?        @relation(fields: [branchId, storeId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  storeMoyskladId   String?            @map("store_moysklad_id")
  storeNameSnapshot String?            @map("store_name_snapshot")
  organizationId    String?            @map("organization_id")
  organization      LocalOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationName  String?            @map("organization_name")

  attributes Json?
  raw        Json?
  syncedAt   DateTime @default(now()) @map("synced_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  positions              LocalDemandPosition[]
  diagnosticMapSessions  DiagnosticMapSession[]
  closingDocuments       ClosingDocument[]
  revisions              ShipmentRevision[]
  inventoryLedgerEntries InventoryLedgerEntry[]

  @@index([branchId, name])
  @@unique([branchId, moyskladId])
  @@unique([branchId, id])
  @@index([documentDate])
  @@index([branchId, documentDate])
  @@index([momentAt])
  @@index([branchId, momentAt])
  @@index([applicable])
  @@index([counterpartyId])
  @@index([agentMoyskladId])
  @@index([storeId])
  @@index([organizationId])
  @@map("local_demands")
}

/// Журнал редакций отгрузки: создание, проведение, возврат в черновик, повторное проведение и правки.
model ShipmentRevision {
  id                 String      @id @default(cuid())
  branchId           String      @default("branch-main") @map("branch_id")
  shipmentId         String      @map("shipment_id")
  shipment           LocalDemand @relation(fields: [branchId, shipmentId], references: [branchId, id], onDelete: Cascade, onUpdate: Cascade)
  revisionNumber     Int         @map("revision_number")
  eventType          String      @map("event_type")
  statusBefore       String?     @map("status_before")
  statusAfter        String?     @map("status_after")
  snapshotBeforeJson Json?       @map("snapshot_before_json")
  snapshotAfterJson  Json?       @map("snapshot_after_json")
  reasonCode         String?     @map("reason_code")
  reason             String?     @db.Text
  createdById        String?     @map("created_by_id")
  createdByName      String?     @map("created_by_name")
  createdAt          DateTime    @default(now()) @map("created_at")

  @@index([shipmentId, revisionNumber])
  @@index([eventType])
  @@index([createdAt])
  @@map("shipment_revisions")
}

/// Неизменяемый журнал складских движений по отгрузкам.
model InventoryLedgerEntry {
  branchId          String                  @default("branch-main") @map("branch_id")
  id                String                  @id @default(cuid())
  sourceType        String                  @map("source_type")
  sourceId          String                  @map("source_id")
  organizationId    String?                 @map("organization_id")
  organization      LocalOrganization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  shipmentId        String?                 @map("shipment_id")
  shipment          LocalDemand?            @relation(fields: [branchId, shipmentId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  productId         String?                 @map("product_id")
  product           LocalProduct?           @relation(fields: [branchId, productId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  storeId           String?                 @map("store_id")
  store             LocalStore?             @relation(fields: [branchId, storeId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  cellId            String?                 @map("cell_id")
  batchId           String?                 @map("batch_id")
  movementType      String                  @map("movement_type")
  quantityDelta     Decimal                 @map("quantity_delta") @db.Decimal(14, 3)
  unitCostSnapshot  Int?                    @map("unit_cost_snapshot")
  totalCostSnapshot Int?                    @map("total_cost_snapshot")
  analyticsImpact   Boolean                 @default(true) @map("analytics_impact")
  originalEntryId   String?                 @map("original_entry_id")
  originalEntry     InventoryLedgerEntry?   @relation("InventoryLedgerReversal", fields: [originalEntryId], references: [id], onDelete: SetNull)
  reversalEntries   InventoryLedgerEntry[]  @relation("InventoryLedgerReversal")
  inventoryLinks    InventoryMovementLink[]
  revision          Int                     @default(1)
  createdById       String?                 @map("created_by_id")
  createdByName     String?                 @map("created_by_name")
  raw               Json?
  createdAt         DateTime                @default(now()) @map("created_at")

  @@index([sourceType, sourceId])
  @@index([organizationId])
  @@index([shipmentId])
  @@index([productId])
  @@index([storeId])
  @@index([cellId])
  @@index([batchId])
  @@index([movementType])
  @@index([createdAt])
  @@index([branchId])
  @@map("inventory_ledger_entries")
}

/// Документ инвентаризации: настройка, подсчёт, сверка и проведение.
model InventorySession {
  branchId                  String            @default("branch-main") @map("branch_id")
  id                        String            @id @default(cuid())
  organizationId            String            @map("organization_id")
  organization              LocalOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouseId               String            @map("warehouse_id")
  warehouse                 LocalStore        @relation(fields: [branchId, warehouseId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  number                    String
  status                    String            @default("DRAFT")
  countMode                 String            @default("BLIND") @map("count_mode")
  warehouseMode             String            @default("LOCKED") @map("warehouse_mode")
  scopeType                 String            @default("WAREHOUSE") @map("scope_type")
  scopeJson                 Json?             @map("scope_json")
  optionsJson               Json?             @map("options_json")
  snapshotAt                DateTime?         @map("snapshot_at")
  startedAt                 DateTime?         @map("started_at")
  countingCompletedAt       DateTime?         @map("counting_completed_at")
  reviewedAt                DateTime?         @map("reviewed_at")
  approvedAt                DateTime?         @map("approved_at")
  postedAt                  DateTime?         @map("posted_at")
  reversedAt                DateTime?         @map("reversed_at")
  cancelledAt               DateTime?         @map("cancelled_at")
  createdById               String?           @map("created_by_id")
  createdByName             String?           @map("created_by_name")
  responsibleId             String?           @map("responsible_id")
  approvedById              String?           @map("approved_by_id")
  comment                   String?           @db.Text
  reverseReason             String?           @map("reverse_reason") @db.Text
  cancelReason              String?           @map("cancel_reason") @db.Text
  totalLines                Int               @default(0) @map("total_lines")
  countedLines              Int               @default(0) @map("counted_lines")
  matchingLines             Int               @default(0) @map("matching_lines")
  shortageLines             Int               @default(0) @map("shortage_lines")
  surplusLines              Int               @default(0) @map("surplus_lines")
  recountRequiredLines      Int               @default(0) @map("recount_required_lines")
  totalShortageCostCents    Int               @default(0) @map("total_shortage_cost_cents")
  totalSurplusCostCents     Int               @default(0) @map("total_surplus_cost_cents")
  managementExpenseCents    Int               @default(0) @map("management_expense_cents")
  technicalAdjustmentCents  Int               @default(0) @map("technical_adjustment_cents")
  lastPostIdempotencyKey    String?           @map("last_post_idempotency_key")
  lastReverseIdempotencyKey String?           @map("last_reverse_idempotency_key")
  version                   Int               @default(1)
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  lines         InventoryLine[]
  assignments   InventoryAssignment[]
  locks         InventoryLock[]
  movementLinks InventoryMovementLink[]
  auditLogs     InventoryAuditLog[]

  @@unique([branchId, organizationId, number])
  @@unique([branchId, id])
  @@index([warehouseId])
  @@index([status])
  @@index([scopeType])
  @@index([snapshotAt])
  @@index([startedAt])
  @@index([postedAt])
  @@index([branchId])
  @@map("inventory_sessions")
}

/// Строка инвентаризации по товару, складу, ячейке и партии.
model InventoryLine {
  branchId                  String           @default("branch-main") @map("branch_id")
  id                        String           @id @default(cuid())
  inventorySessionId        String           @map("inventory_session_id")
  session                   InventorySession @relation(fields: [branchId, inventorySessionId], references: [branchId, id], onDelete: Cascade, onUpdate: Cascade)
  productId                 String?          @map("product_id")
  product                   LocalProduct?    @relation(fields: [branchId, productId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  warehouseId               String           @map("warehouse_id")
  warehouse                 LocalStore       @relation(fields: [branchId, warehouseId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  cellId                    String?          @map("cell_id")
  batchId                   String?          @map("batch_id")
  unitId                    String?          @map("unit_id")
  snapshotQuantity          Decimal          @default(0) @map("snapshot_quantity") @db.Decimal(14, 3)
  snapshotReservedQuantity  Decimal          @default(0) @map("snapshot_reserved_quantity") @db.Decimal(14, 3)
  snapshotAvailableQuantity Decimal          @default(0) @map("snapshot_available_quantity") @db.Decimal(14, 3)
  expectedQuantityAtCount   Decimal          @default(0) @map("expected_quantity_at_count") @db.Decimal(14, 3)
  firstCountQuantity        Decimal?         @map("first_count_quantity") @db.Decimal(14, 3)
  secondCountQuantity       Decimal?         @map("second_count_quantity") @db.Decimal(14, 3)
  finalQuantity             Decimal?         @map("final_quantity") @db.Decimal(14, 3)
  differenceQuantity        Decimal?         @map("difference_quantity") @db.Decimal(14, 3)
  unitCostSnapshotCents     Int?             @map("unit_cost_snapshot_cents")
  differenceCostCents       Int?             @map("difference_cost_cents")
  countedAt                 DateTime?        @map("counted_at")
  countedById               String?          @map("counted_by_id")
  recountedAt               DateTime?        @map("recounted_at")
  recountedById             String?          @map("recounted_by_id")
  status                    String           @default("NOT_COUNTED")
  proposedAction            String?          @map("proposed_action")
  finalAction               String?          @map("final_action")
  reasonCode                String?          @map("reason_code")
  comment                   String?          @db.Text
  requiresRecount           Boolean          @default(false) @map("requires_recount")
  affectsManagementProfit   Boolean          @default(true) @map("affects_management_profit")
  isUnexpected              Boolean          @default(false) @map("is_unexpected")
  exclusionReason           String?          @map("exclusion_reason") @db.Text
  stockVersion              Int              @default(1) @map("stock_version")
  lockOwnerId               String?          @map("lock_owner_id")
  lockExpiresAt             DateTime?        @map("lock_expires_at")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  countEntries  InventoryCountEntry[]
  attachments   InventoryAttachment[]
  movementLinks InventoryMovementLink[]
  auditLogs     InventoryAuditLog[]

  @@index([inventorySessionId])
  @@index([productId])
  @@index([warehouseId])
  @@index([cellId])
  @@index([batchId])
  @@index([status])
  @@index([requiresRecount])
  @@index([branchId])
  @@unique([branchId, id])
  @@map("inventory_lines")
}

/// Неизменяемая история вводов фактического количества.
model InventoryCountEntry {
  branchId        String        @default("branch-main") @map("branch_id")
  id              String        @id @default(cuid())
  inventoryLineId String        @map("inventory_line_id")
  line            InventoryLine @relation(fields: [branchId, inventoryLineId], references: [branchId, id], onDelete: Cascade, onUpdate: Cascade)
  sequence        Int
  quantity        Decimal       @db.Decimal(14, 3)
  counterId       String?       @map("counter_id")
  countedAt       DateTime      @default(now()) @map("counted_at")
  comment         String?       @db.Text
  source          String        @default("MANUAL")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([branchId, inventoryLineId, sequence])
  @@index([inventoryLineId])
  @@index([counterId])
  @@index([source])
  @@index([branchId])
  @@map("inventory_count_entries")
}

/// Вложения к строкам инвентаризации. storageKey должен указывать на постоянное object storage.
model InventoryAttachment {
  branchId        String        @default("branch-main") @map("branch_id")
  id              String        @id @default(cuid())
  inventoryLineId String        @map("inventory_line_id")
  line            InventoryLine @relation(fields: [branchId, inventoryLineId], references: [branchId, id], onDelete: Cascade, onUpdate: Cascade)
  type            String
  storageKey      String        @map("storage_key") @db.Text
  fileName        String        @map("file_name")
  mimeType        String        @map("mime_type")
  size            Int
  uploadedById    String?       @map("uploaded_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([inventoryLineId])
  @@index([type])
  @@index([branchId])
  @@map("inventory_attachments")
}

/// Связь строк инвентаризации с созданными складскими движениями и документами.
model InventoryMovementLink {
  branchId           String                @default("branch-main") @map("branch_id")
  id                 String                @id @default(cuid())
  inventorySessionId String                @map("inventory_session_id")
  session            InventorySession      @relation(fields: [inventorySessionId], references: [id], onDelete: Cascade)
  inventoryLineId    String?               @map("inventory_line_id")
  line               InventoryLine?        @relation(fields: [inventoryLineId], references: [id], onDelete: SetNull)
  ledgerEntryId      String?               @map("ledger_entry_id")
  ledgerEntry        InventoryLedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  documentType       String?               @map("document_type")
  documentId         String?               @map("document_id")
  createdAt          DateTime              @default(now()) @map("created_at")

  @@index([inventorySessionId])
  @@index([inventoryLineId])
  @@index([ledgerEntryId])
  @@index([documentType, documentId])
  @@index([branchId])
  @@map("inventory_movement_links")
}

/// Назначения сотрудников на области подсчёта.
model InventoryAssignment {
  branchId           String           @default("branch-main") @map("branch_id")
  id                 String           @id @default(cuid())
  inventorySessionId String           @map("inventory_session_id")
  session            InventorySession @relation(fields: [inventorySessionId], references: [id], onDelete: Cascade)
  employeeId         String           @map("employee_id")
  scopeJson          Json?            @map("scope_json")
  status             String           @default("ACTIVE")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([inventorySessionId])
  @@index([employeeId])
  @@index([status])
  @@index([branchId])
  @@map("inventory_assignments")
}

/// Блокировка пересекающейся области активной инвентаризации.
model InventoryLock {
  branchId           String            @default("branch-main") @map("branch_id")
  id                 String            @id @default(cuid())
  organizationId     String            @map("organization_id")
  organization       LocalOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId        String            @map("warehouse_id")
  warehouse          LocalStore        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId          String?           @map("product_id")
  product            LocalProduct?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId         String?           @map("category_id")
  cellId             String?           @map("cell_id")
  batchId            String?           @map("batch_id")
  inventorySessionId String            @map("inventory_session_id")
  session            InventorySession  @relation(fields: [inventorySessionId], references: [id], onDelete: Cascade)
  lockedAt           DateTime          @default(now()) @map("locked_at")
  releasedAt         DateTime?         @map("released_at")

  @@index([organizationId, warehouseId])
  @@index([productId])
  @@index([categoryId])
  @@index([cellId])
  @@index([inventorySessionId])
  @@index([releasedAt])
  @@index([branchId])
  @@map("inventory_locks")
}

/// Будущие плановые инвентаризации: модель готова, автоматический планировщик добавляется отдельно.
model InventorySchedule {
  branchId       String   @default("branch-main") @map("branch_id")
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  warehouseId    String   @map("warehouse_id")
  scopeType      String   @map("scope_type")
  scopeJson      Json?    @map("scope_json")
  frequency      String
  responsibleId  String?  @map("responsible_id")
  nextDate       DateTime @map("next_date")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, warehouseId])
  @@index([nextDate])
  @@index([active])
  @@index([branchId])
  @@map("inventory_schedules")
}

/// Аудит действий по инвентаризации и изменениям строк.
model InventoryAuditLog {
  branchId           String           @default("branch-main") @map("branch_id")
  id                 String           @id @default(cuid())
  inventorySessionId String           @map("inventory_session_id")
  session            InventorySession @relation(fields: [inventorySessionId], references: [id], onDelete: Cascade)
  inventoryLineId    String?          @map("inventory_line_id")
  line               InventoryLine?   @relation(fields: [inventoryLineId], references: [id], onDelete: SetNull)
  action             String
  oldValueJson       Json?            @map("old_value_json")
  newValueJson       Json?            @map("new_value_json")
  userId             String?          @map("user_id")
  userName           String?          @map("user_name")
  source             String?          @default("UI")
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([inventorySessionId])
  @@index([inventoryLineId])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@index([branchId])
  @@map("inventory_audit_logs")
}

/// Snapshot закрывающего документа по отгрузке: печатные формы не меняются молча после выпуска.
model ClosingDocument {
  branchId                   String             @default("branch-main") @map("branch_id")
  id                         String             @id @default(cuid())
  organizationId             String?            @map("organization_id")
  organization               LocalOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  shipmentId                 String             @map("shipment_id")
  shipment                   LocalDemand        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type                       String
  number                     String
  revision                   Int                @default(1)
  status                     String             @default("issued")
  documentDate               String             @map("document_date")
  completionDate             String             @map("completion_date")
  sellerSnapshot             Json               @map("seller_snapshot")
  buyerSnapshot              Json               @map("buyer_snapshot")
  vehicleSnapshot            Json               @map("vehicle_snapshot")
  positionsSnapshot          Json               @map("positions_snapshot")
  totalsSnapshot             Json               @map("totals_snapshot")
  vatSnapshot                Json               @map("vat_snapshot")
  acceptanceText             String             @map("acceptance_text") @db.Text
  customerRemarks            String?            @map("customer_remarks") @db.Text
  transferSnapshot           Json?              @map("transfer_snapshot")
  performerSignatorySnapshot Json?              @map("performer_signatory_snapshot")
  customerSignatorySnapshot  Json?              @map("customer_signatory_snapshot")
  sourceHash                 String             @map("source_hash")
  createdById                String             @map("created_by_id")
  createdByName              String?            @map("created_by_name")
  createdAt                  DateTime           @default(now()) @map("created_at")
  issuedAt                   DateTime?          @default(now()) @map("issued_at")
  cancelledAt                DateTime?          @map("cancelled_at")
  cancelledById              String?            @map("cancelled_by_id")
  cancelledByName            String?            @map("cancelled_by_name")
  cancelReason               String?            @map("cancel_reason") @db.Text

  @@unique([branchId, organizationId, type, number])
  @@index([shipmentId])
  @@index([organizationId, type, documentDate])
  @@index([status])
  @@index([branchId])
  @@map("closing_documents")
}

/// Годовые последовательности номеров закрывающих документов по организации и типу.
model ClosingDocumentNumberSequence {
  branchId       String   @default("branch-main") @map("branch_id")
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  type           String
  year           Int
  lastNumber     Int      @default(0) @map("last_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([branchId, organizationId, type, year])
  @@index([branchId])
  @@map("closing_document_number_sequences")
}

/// Позиции локальной отгрузки.
model LocalDemandPosition {
  branchId             String        @default("branch-main") @map("branch_id")
  id                   String        @id @default(cuid())
  demandId             String        @map("demand_id")
  demand               LocalDemand   @relation(fields: [branchId, demandId], references: [branchId, id], onDelete: Cascade, onUpdate: Cascade)
  moyskladPositionId   String?       @map("moysklad_position_id")
  productId            String?       @map("product_id")
  product              LocalProduct? @relation(fields: [branchId, productId], references: [branchId, id], onDelete: Restrict, onUpdate: Cascade)
  assortmentMoyskladId String?       @map("assortment_moysklad_id")
  assortmentType       String        @map("assortment_type")
  name                 String
  quantity             Decimal       @default(0) @db.Decimal(14, 3)
  priceCentsPerUnit    Int           @default(0) @map("price_cents_per_unit")
  discount             Decimal       @default(0) @db.Decimal(7, 3)
  vat                  Int           @default(0)
  vatEnabled           Boolean       @default(false) @map("vat_enabled")
  buyPriceCentsPerUnit Int?          @map("buy_price_cents_per_unit")
  slotName             String?       @map("slot_name")
  raw                  Json?

  @@index([demandId])
  @@index([productId])
  @@index([assortmentType, assortmentMoyskladId])
  @@index([branchId])
  @@unique([branchId, moyskladPositionId])
  @@map("local_demand_positions")
}

/// Локальные определения дополнительных полей отгрузки.
model DemandAttributeDefinition {
  branchId  String   @default("branch-main") @map("branch_id")
  id        String   @id @default(cuid())
  name      String
  type      String   @default("string")
  required  Boolean  @default(false)
  order     Int      @default(0)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([branchId, name])
  @@index([order])
  @@index([branchId])
  @@map("demand_attribute_definitions")
}

/// Локальные складские документы: приёмка, списание и будущие корректировки.
model LocalInventoryDocument {
  branchId                String   @default("branch-main") @map("branch_id")
  id                      String   @id @default(cuid())
  type                    String
  name                    String
  momentAt                DateTime @map("moment_at")
  documentDate            String   @map("document_date")
  status                  String   @default("posted")
  applicable              Boolean  @default(true)
  sumCents                Int      @default(0) @map("sum_cents")
  description             String?  @db.Text
  adjustmentType          String?  @map("adjustment_type")
  adjustmentMethod        String?  @map("adjustment_method")
  adjustmentReason        String?  @map("adjustment_reason") @db.Text
  affectsManagementProfit Boolean  @default(true) @map("affects_management_profit")

  counterpartyId           String?            @map("counterparty_id")
  counterparty             LocalCounterparty? @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  counterpartyNameSnapshot String?            @map("counterparty_name_snapshot")

  storeId           String?     @map("store_id")
  store             LocalStore? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  storeNameSnapshot String?     @map("store_name_snapshot")

  createdByLogin   String?   @map("created_by_login")
  createdByName    String?   @map("created_by_name")
