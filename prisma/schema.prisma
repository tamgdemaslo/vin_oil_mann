  atf                       String?
  ilsac                     String?
  aceaExtra                 String?   @map("acea_extra")
  oemAtf                    String?   @map("oem_atf") @db.Text
  mannName                  String?   @map("mann_name")
  rosskoPartNumber          String?   @map("rossko_part_number")
  rosskoBrand               String?   @map("rossko_brand")
  rosskoMin                 String?   @map("rossko_min")
  supplierAttribute         String?   @map("supplier_attribute")
  oemParts                  String?   @map("oem_parts") @db.Text
  cell                      String?
  params                    String?   @db.Text
  mannCharacteristicName    String?   @map("mann_characteristic_name")
  imageHref                 String?   @map("image_href") @db.Text
