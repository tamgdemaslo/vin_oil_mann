  humanApprovalReason      String?   @map("human_approval_reason")
  lastToolName             String?   @map("last_tool_name")
  lastToolStatus           String?   @map("last_tool_status")
  completedStagesJson      Json      @default("[]") @map("completed_stages_json")
  collectedDataSummaryJson Json      @default("{}") @map("collected_data_summary_json")
  errorCode                String?   @map("error_code")
  errorMessage             String?   @map("error_message") @db.Text
  retryCount               Int       @default(0) @map("retry_count")
  clientProgressMessageId  String?   @map("client_progress_message_id")
  createdBy                String?   @map("created_by")
  startedAt                DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt              DateTime? @map("completed_at") @db.Timestamptz(6)
  failedAt                 DateTime? @map("failed_at") @db.Timestamptz(6)
  cancelledAt              DateTime? @map("cancelled_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

