}

// --- Диагностический лист при отгрузке ---

enum DiagnosticStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum DiagnosticBlock {
  AGGREGATE_FLUID
  SERVICE_FLUID
  VISUAL
  SURVEY
}

enum DiagnosticPositionStatus {
  NOT_CHECKED
  GREEN
  YELLOW
  RED
  SKIPPED
}

model Diagnostic {
  id                 String  @id @default(uuid())
  shipmentMoySkladId String? @map("shipment_moysklad_id")
  shipmentDraftId    String? @map("shipment_draft_id")
  agentMoySkladId    String? @map("agent_moysklad_id")

  vin          String?
  brand        String?
  model        String?
  year         Int?
  licensePlate String? @map("license_plate")
  mileage      Int?

  mechanicLogin String? @map("mechanic_login")

  status              DiagnosticStatus @default(IN_PROGRESS)
  startedAt           DateTime         @default(now()) @map("started_at")
  completedAt         DateTime?        @map("completed_at")
  clientReportSentAt  DateTime?        @map("client_report_sent_at")
  clientReportToken   String           @unique @default(uuid()) @map("client_report_token")
  clientWantsReminder Boolean          @default(true) @map("client_wants_reminder")

  summaryGreen  Int @default(0) @map("summary_green")
  summaryYellow Int @default(0) @map("summary_yellow")
  summaryRed    Int @default(0) @map("summary_red")

  positions DiagnosticPosition[]
  offers    DiagnosticOffer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([vin])
  @@index([agentMoySkladId])
  @@index([shipmentMoySkladId])
  @@map("diagnostics")
}

model DiagnosticPosition {
  id           String     @id @default(uuid())
  diagnosticId String     @map("diagnostic_id")
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  block  DiagnosticBlock
  node   String
  status DiagnosticPositionStatus @default(NOT_CHECKED)

  tags             String[]
  measurementValue Decimal? @map("measurement_value") @db.Decimal(10, 2)
  measurementUnit  String?  @map("measurement_unit")
  recommendation   String?
  notes            String?  @db.Text

  photos DiagnosticPhoto[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([diagnosticId, node])
  @@index([diagnosticId])
  @@map("diagnostic_positions")
}

model DiagnosticPhoto {
  id         String             @id @default(uuid())
  positionId String             @map("position_id")
  position   DiagnosticPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  filePath String  @map("file_path")
  caption  String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([positionId])
  @@map("diagnostic_photos")
}

model DiagnosticOffer {
  id           String     @id @default(uuid())
  diagnosticId String     @map("diagnostic_id")
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  relatedPositionId    String? @map("related_position_id")
  offerKey             String  @map("offer_key")
  title                String
  variants             Json
  selectedVariantIndex Int?    @map("selected_variant_index")
  addedToShipment      Boolean @default(false) @map("added_to_shipment")
  nextVisitOnly        Boolean @default(false) @map("next_visit_only")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([diagnosticId])
  @@map("diagnostic_offers")
}

// --- Новая карта диагностики ---

enum DiagnosticMapSessionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum DiagnosticMapItemStatus {
  UNCHECKED
  NORMAL
  ATTENTION
  REPLACE
  NO_ACCESS
  BY_MILEAGE
  BY_CLIENT
  SKIPPED
  NOT_APPLICABLE
}

enum DiagnosticMapCheckMethod {
  INSPECTION
  CLIENT_WORDS
  MILEAGE
  NO_ACCESS
  SKIPPED
}

enum DiagnosticMapApplicability {
  APPLICABLE
  NOT_APPLICABLE
  HIDDEN
}

enum DiagnosticMapActionKind {
  ADD_TO_SHIPMENT
  CREATE_CRM_TASK
  NEXT_VISIT
  SHOW_IN_REPORT
}

model DiagnosticMapSession {
  id       String       @id @default(cuid())
  demandId String?      @map("demand_id")
  demand   LocalDemand? @relation(fields: [demandId], references: [id], onDelete: SetNull)

  clientId    String? @map("client_id")
  clientName  String? @map("client_name")
  clientPhone String? @map("client_phone")

  vin          String?
  brand        String?
  model        String?
  year         Int?
  licensePlate String? @map("license_plate")
  mileage      Int?
  vehicleHints Json?   @map("vehicle_hints")

  masterLogin String? @map("master_login")
  masterName  String? @map("master_name")

  status              DiagnosticMapSessionStatus @default(IN_PROGRESS)
  publicToken         String                     @unique @default(cuid()) @map("public_token")
  startedAt           DateTime                   @default(now()) @map("started_at")
  completedAt         DateTime?                  @map("completed_at")
  reportSentAt        DateTime?                  @map("report_sent_at")
  clientWantsReminder Boolean                    @default(true) @map("client_wants_reminder")

  totalCount                   Int @default(0) @map("total_count")
  normalCount                  Int @default(0) @map("normal_count")
  attentionCount               Int @default(0) @map("attention_count")
  replaceCount                 Int @default(0) @map("replace_count")
  indirectCount                Int @default(0) @map("indirect_count")
  noAccessCount                Int @default(0) @map("no_access_count")
  byMileageCount               Int @default(0) @map("by_mileage_count")
  byClientCount                Int @default(0) @map("by_client_count")
  withPhotoCount               Int @default(0) @map("with_photo_count")
  withoutPhotoCount            Int @default(0) @map("without_photo_count")
  nowRecommendationCount       Int @default(0) @map("now_recommendation_count")
  nextVisitRecommendationCount Int @default(0) @map("next_visit_recommendation_count")

  items        DiagnosticMapItem[]
  vehiclePhoto DiagnosticMapVehiclePhoto?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([demandId])
  @@index([clientId])
  @@index([vin])
  @@index([status])
  @@map("diagnostic_map_sessions")
}

model DiagnosticMapItem {
  id        String               @id @default(cuid())
  sessionId String               @map("session_id")
  session   DiagnosticMapSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  blockCode       String @map("block_code")
  blockTitle      String @map("block_title")
  blockOrder      Int    @map("block_order")
  itemCode        String @map("item_code")
  itemTitle       String @map("item_title")
  itemOrder       Int    @map("item_order")
  catalogSnapshot Json   @map("catalog_snapshot")

  applicability DiagnosticMapApplicability @default(APPLICABLE)
  status        DiagnosticMapItemStatus    @default(UNCHECKED)
  checkMethod   DiagnosticMapCheckMethod   @default(INSPECTION) @map("check_method")

  value          String?
  comment        String? @db.Text
  recommendation String? @db.Text
  nextVisit      Boolean @default(false) @map("next_visit")
  showInReport   Boolean @default(true) @map("show_in_report")

  selectedNotes           String[] @map("selected_notes")
  selectedRecommendations String[] @map("selected_recommendations")

  photos  DiagnosticMapPhoto[]
  actions DiagnosticMapRecommendationAction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, itemCode])
  @@index([sessionId])
  @@index([status])
  @@map("diagnostic_map_items")
}

model DiagnosticMapPhoto {
  id     String            @id @default(cuid())
  itemId String            @map("item_id")
  item   DiagnosticMapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  filePath    String  @map("file_path")
  contentType String? @map("content_type")
  sizeBytes   Int?    @map("size_bytes")
  data        Bytes?
  caption     String
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([itemId])
  @@map("diagnostic_map_photos")
}

model DiagnosticMapVehiclePhoto {
  id        String               @id @default(cuid())
  sessionId String               @unique @map("session_id")
  session   DiagnosticMapSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  filePath    String  @map("file_path")
  contentType String? @map("content_type")
  sizeBytes   Int?    @map("size_bytes")
  data        Bytes?
  caption     String?
  uploadedBy  String? @map("uploaded_by")
  source      String  @default("diagnostic")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("diagnostic_map_vehicle_photos")
}

model DiagnosticMapRecommendationAction {
  id     String            @id @default(cuid())
  itemId String            @map("item_id")
  item   DiagnosticMapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  kind                  DiagnosticMapActionKind
  title                 String
  status                String                  @default("open")
  localDemandPositionId String?                 @map("local_demand_position_id")
  crmDealId             String?                 @map("crm_deal_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([itemId])
  @@index([kind])
  @@map("diagnostic_map_recommendation_actions")
}

// --- Локальное складское ядро ---

/// Локальный справочник организаций для документов.
model LocalOrganization {
  id           String  @id @default(cuid())
  moyskladId   String? @unique @map("moysklad_id")
  moyskladHref String? @map("moysklad_href") @db.Text
  name         String

  entityType    String  @default("legal_entity") @map("entity_type")
  fullLegalName String? @map("full_legal_name") @db.Text
  inn           String?
  kpp           String?
  ogrn          String?
  ogrnip        String?
  legalAddress  String? @map("legal_address") @db.Text
  actualAddress String? @map("actual_address") @db.Text
  phone         String?
  email         String?
  website       String?

  taxSystem      String? @map("tax_system")
  vatEnabled     Boolean @default(false) @map("vat_enabled")
  defaultVatRate Int?    @map("default_vat_rate")
  currency       String  @default("RUB")

  bankName             String? @map("bank_name")
  bik                  String?
  checkingAccount      String? @map("checking_account")
  correspondentAccount String? @map("correspondent_account")

  signatoryName      String? @map("signatory_name")
  signatoryPosition  String? @map("signatory_position")
  signatoryAuthority String? @map("signatory_authority")

  shipmentPrefix  String? @map("shipment_prefix")
  workOrderPrefix String? @map("work_order_prefix")
  actPrefix       String? @map("act_prefix")
  updPrefix       String? @map("upd_prefix")

  isDefault  Boolean   @default(false) @map("is_default")
  isActive   Boolean   @default(true) @map("is_active")
  archivedAt DateTime? @map("archived_at")
  raw        Json?
  syncedAt   DateTime  @default(now()) @map("synced_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  stores                 LocalStore[]
  demands                LocalDemand[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  closingDocuments       ClosingDocument[]
  cashExpenseOrders      CashExpenseOrder[]
  members                OrganizationMember[]
  inventorySessions      InventorySession[]
  inventoryLocks         InventoryLock[]

  @@index([name])
  @@index([inn])
  @@index([isDefault])
  @@index([isActive])
  @@map("local_organizations")
}

/// Доступ пользователя к организациям. userId сейчас хранит логин из AUTH_USERS.
model OrganizationMember {
  id              String            @id @default(cuid())
  organizationId  String            @map("organization_id")
  organization    LocalOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String            @map("user_id")
  role            String            @default("member")
  permissionsJson Json?             @map("permissions_json")
  isDefault       Boolean           @default(false) @map("is_default")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([isDefault])
  @@map("organization_members")
}

/// Справочник складов, импортированный из МойСклад и пригодный для дальнейшей локальной работы.
model LocalStore {
  id             String             @id @default(cuid())
  moyskladId     String?            @unique @map("moysklad_id")
  moyskladHref   String?            @map("moysklad_href") @db.Text
  name           String
  organizationId String?            @map("organization_id")
  organization   LocalOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isMain         Boolean            @default(false) @map("is_main")
  archived       Boolean            @default(false)
  raw            Json?
  syncedAt       DateTime           @default(now()) @map("synced_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  stockBalances          LocalStockBalance[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  demands                LocalDemand[]
  inventoryDocuments     LocalInventoryDocument[]
  cashExpenseOrders      CashExpenseOrder[]
  inventorySessions      InventorySession[]
  inventoryLines         InventoryLine[]
  inventoryLocks         InventoryLock[]

  @@index([name])
  @@index([organizationId])
  @@map("local_stores")
}

