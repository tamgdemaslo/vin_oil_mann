/// Локальный справочник контрагентов.
model LocalCounterparty {
  id                   String    @id @default(cuid())
  branchId             String    @default("branch-main") @map("branch_id")
  moyskladId           String?   @map("moysklad_id")
  moyskladHref         String?   @map("moysklad_href") @db.Text
  name                 String
  /// Canonical name for new counterparty workflows; name is retained for legacy integrations.
  displayName          String    @default("") @map("display_name")
  /// Business role in the local branch: INDIVIDUAL by default, SUPPLIER for product suppliers.
  category             String    @default("INDIVIDUAL")
  /// Supplier legal form: LEGAL_ENTITY, SOLE_PROPRIETOR, or OTHER.
  legalForm            String?  @map("legal_form")
  fullName             String?  @map("full_name") @db.Text
  actualAddress        String?  @map("actual_address") @db.Text
  contactPerson        String?  @map("contact_person")
  contactPhone         String?  @map("contact_phone")
  bankDetailsJson      Json?    @map("bank_details_json")
  /// Mirrors the operational state for API consumers; archived remains for legacy workflows.
  status               String    @default("ACTIVE")
  phone                String?
  email                String?
  normalizedPhone      String?   @map("normalized_phone")
  phonesRaw            Json?     @map("phones_raw")
  companyType          String?   @map("company_type")
  counterpartyTypeName String?   @map("counterparty_type_name")
  legalTitle           String?   @map("legal_title")
  legalLastName        String?   @map("legal_last_name")
  legalFirstName       String?   @map("legal_first_name")
  legalMiddleName      String?   @map("legal_middle_name")
  legalAddress         String?   @map("legal_address") @db.Text
  inn                  String?
  kpp                  String?
  okpo                 String?
  fax                  String?
  bik                  String?
  bankName             String?   @map("bank_name")
  bankLocation         String?   @map("bank_location") @db.Text
  correspondentAccount String?   @map("correspondent_account")
  checkingAccount      String?   @map("checking_account")
  ogrn                 String?
  ogrnip               String?
  certificateNumber    String?   @map("certificate_number")
  certificateDate      DateTime? @map("certificate_date") @db.Date
  searchText           String    @default("") @map("search_text") @db.Text
  archived             Boolean   @default(false)
  raw                  Json?
  syncedAt             DateTime  @default(now()) @map("synced_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  demands            LocalDemand[]
  inventoryDocuments LocalInventoryDocument[]
  cashExpenseOrders  CashExpenseOrder[]
  suppliedProducts   LocalProduct[] @relation("ProductSupplierCounterparty")

  @@index([name])
  @@index([branchId, archived])
  @@index([branchId, category])
  @@index([branchId, name])
  @@index([branchId, inn])
  @@index([branchId, normalizedPhone])
  @@index([normalizedPhone])
  @@index([inn])
  @@unique([branchId, moyskladId])
  @@unique([branchId, id])
  @@map("local_counterparties")
}

/// Локальная кассовая смена. Источник истины для открытия/закрытия кассы.
