# Готовый «заполненный» шаблон с заглушками → см. .env.local.template
# (скопируйте: cp .env.local.template .env.local и подставьте свои ключи.)

# Parts Catalogs API (как в проекте "vin pin") — приоритетный источник фильтров по VIN
# https://api.parts-catalogs.com/v1, авторизация: заголовок Authorization с ключом
PARTS_CATALOGS_API_KEY=
# Базовый URL (опционально): PARTS_CATALOGS_API_BASE=https://api.parts-catalogs.com/v1

# Ключ OpenAI (https://platform.openai.com/account/api-keys) — допуск масла и заправочный объём
OPENAI_API_KEY=sk-...
# Модель для допуска/объёма масла (по умолчанию gpt-4o-mini). Пример: OPENAI_OIL_MODEL=gpt-4o-mini
# OPENAI_OIL_MODEL=

# Serper — поиск по вебу для OEM по разным источникам (https://serper.dev), опционально
SERPER_API_KEY=

# МойСклад — поиск по OEM и создание отгрузок (https://dev.moysklad.ru/doc/api/remap/1.2/)
# Если задан токен — используется он (Bearer). Иначе пара логин/пароль (Basic).
MOYSKLAD_TOKEN=
MOYSKLAD_LOGIN=
MOYSKLAD_PASSWORD=
# Безопасное отключение live-интеграции. Для проверки cutover выставьте все четыре флага в false.
DAYS_TO_SYNC=14
MOYSKLAD_ENABLED=false
MOYSKLAD_READ_ENABLED=false
MOYSKLAD_WRITE_ENABLED=false
MOYSKLAD_SYNC_ENABLED=false
# Debug/manual sync должен быть доступен только owner/admin и выключен в обычном runtime.
MOYSKLAD_DEBUG_ENABLED=false
NEXT_PUBLIC_MOYSKLAD_DEBUG_ENABLED=false
# Rollback read-only профиль при критичной проблеме:
# MOYSKLAD_ENABLED=true
# MOYSKLAD_DEBUG_ENABLED=true
# MOYSKLAD_READ_ENABLED=true
# MOYSKLAD_SYNC_ENABLED=true
# MOYSKLAD_WRITE_ENABLED=false
# NEXT_PUBLIC_MOYSKLAD_DEBUG_ENABLED=true
# Не включайте MOYSKLAD_WRITE_ENABLED при rollback без отдельного решения.
# Если заданы и токен, и логин/пароль: без этого флага используется Basic; для Bearer укажите 1
# MOYSKLAD_PREFER_BEARER=1
# Таймаут HTTP к API в мс (по умолчанию 15000)
# MOYSKLAD_TIMEOUT_MS=
# Кэш VIN-подбора: общий снимок остатков и каталог масел для следующей отгрузки
# MOYSKLAD_LOOKUP_STOCK_CACHE_MS=600000
# MOYSKLAD_LOOKUP_OIL_CACHE_MS=1800000
# Временный feature flag старого VIN-подбора фильтров в отгрузке.
NEXT_PUBLIC_VIN_FILTER_PICKER_ENABLED=false
# Число повторов при расчёте зарплаты (лимит запросов API), 4–10, по умолчанию 7
# MOYSKLAD_PAYROLL_FETCH_ATTEMPTS=
# Минимальная пауза между запросами МойСклад в расчёте зарплаты, мс (по умолчанию 800)
# MOYSKLAD_PAYROLL_MIN_INTERVAL_MS=
# UUID доп. поля отгрузки с гос. номером (страница /shipment), если имя поля не распознаётся автоматически
# MOYSKLAD_DEMAND_PLATE_ATTRIBUTE_ID=

# Локальное складское зеркало: после импорта через POST /api/local-inventory/sync
# можно читать товары, контрагентов и список отгрузок из нашей БД.
# LOCAL_INVENTORY_READS=1
# Локальная запись: создание/редактирование/удаление отгрузок и движение остатков в нашей БД.
# Включайте после импорта складского зеркала.
# LOCAL_INVENTORY_WRITES=1
# LOCAL_ORGANIZATION_NAME=ИП ЕЛИСЕЕНКО ИЛЬЯ СЕРГЕЕВИЧ
# LOCAL_INVENTORY_DEMAND_SEARCH_SCAN_LIMIT=2000

# Закрывающие документы: реквизиты исполнителя для печатных форм.
# Используются как fallback, если в локальной организации ещё не заполнены реквизиты.
CLOSING_SELLER_LEGAL_NAME="ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ ЕЛИСЕЕНКО ИЛЬЯ СЕРГЕЕВИЧ"
CLOSING_SELLER_SHORT_NAME="ИП Елисеенко Илья Сергеевич"
CLOSING_SELLER_INN=392302838630
CLOSING_SELLER_OGRNIP=319392600035915
CLOSING_SELLER_ADDRESS="238410, РОССИЯ, КАЛИНИНГРАДСКАЯ ОБЛ, ПРАВДИНСКИЙ Р-Н, ПГТ ЖЕЛЕЗНОДОРОЖНЫЙ, УЛ ДЕПОВСКАЯ, Д 1, КВ 7"
CLOSING_SELLER_PHONE="8 (995) 054-58-59"
CLOSING_SELLER_BANK_NAME="АО «Тинькофф Банк»"
CLOSING_SELLER_BANK_LOCATION="127287, г. Москва, ул. Хуторская 2-я, д. 38А, стр. 26"
CLOSING_SELLER_BIK=044525974
CLOSING_SELLER_CHECKING_ACCOUNT=40802810000001162610
CLOSING_SELLER_CORRESPONDENT_ACCOUNT=30101810145250000974
CLOSING_SELLER_SIGNATORY_POSITION="Индивидуальный предприниматель"
CLOSING_SELLER_SIGNATORY_NAME="Елисеенко Илья Сергеевич"
CLOSING_SELLER_SIGNATORY_BASIS="ОГРНИП 319392600035915"

# Публичный API для отдельного клиентского сайта (/api/public/*)
# Через запятую укажите домены фронта, которым разрешены CORS-запросы.
PUBLIC_CLIENT_ORIGINS=https://client-site.ru
# Лимиты на один IP в час для дорогого VIN-подбора и создания заявок.
# PUBLIC_API_VIN_LIMIT_PER_HOUR=20
# PUBLIC_API_LEAD_LIMIT_PER_HOUR=5
# Логин сотрудника, который будет ответственным по заявкам с сайта (опционально).
# PUBLIC_LEAD_RESPONSIBLE_LOGIN=

# Диагностика при отгрузке: каталог фото на диске (по умолчанию .data/diagnostic-photos/)
# DIAGNOSTIC_PHOTOS_PATH=
# Публичная ссылка на отчёт клиенту (если не задано — берётся Host запроса при «Отправить отчёт»)
# NEXT_PUBLIC_APP_ORIGIN=https://your-domain.ru

# Подбор масел по VIN (POST /api/oil-recommendations) и расширенный поиск в /api/lookup:
# ID доп. полей товара — SAE, OEM, ACEA, API, ILSAC, объём, категория.
# Если не заданы, масла ищутся по названию (содержит «масл»/oil) и по полю SAE.
# MOYSKLAD_ATTR_SAE=
# MOYSKLAD_ATTR_OEM= — допуски масел (BMW LL-04, MB 229.51…); при подборе по VIN поиск идёт и по этому полю
# MOYSKLAD_ATTR_ACEA=
# MOYSKLAD_ATTR_API=
# MOYSKLAD_ATTR_ILSAC=
# MOYSKLAD_ATTR_VOLUME=
# MOYSKLAD_ATTR_CATEGORY=
# Кэш VIN→требования (дней, 1–30), по умолчанию 7
# OIL_CACHE_DAYS=7

# Эко-платформа: авторизация работников. Формат: логин:пароль:имя:роль, через запятую — несколько пользователей
# Роль: owner | admin | master. Пример: AUTH_USERS=owner:pass:Владелец:owner,master1:pass:Иван:master
AUTH_USERS=
# Админы, которым разрешено управлять организациями. Владелец имеет доступ всегда.
# ORGANIZATIONS_MANAGERS=vadim
# Соль для хеширования паролей (опционально, смените в проде)
# AUTH_SALT=your-random-salt
# Секрет сессии для cookie (опционально, в проде задайте свой)
# SESSION_SECRET=your-session-secret

# БД для смен и зарплаты (PostgreSQL). Пример: postgresql://user:pass@localhost:5432/vin_oil
DATABASE_URL=postgresql://localhost:5432/vin_oil
# Часовой пояс для смен, дат документов и автозакрытия
APP_TIMEZONE=Europe/Kaliningrad
# Секрет для вызова автозакрытия смен (GET /api/cron/auto-close-shifts?secret=... или Bearer в заголовке)
CRON_SECRET=

# CRM / Дела клиентов: дедлайн-уведомления и получатели контроля.
# CRM_CASE_NOTIFICATIONS_ENABLED=true
# CRM_CASE_DEADLINE_WARNING_MINUTES=15
# CRM_CASE_OVERDUE_REPEAT_MINUTES=15
# CRM_CASE_OWNER_OVERDUE_MODE=all
# CRM_CASE_WATCHER_LOGINS=
# CRM_CASE_TELEGRAM_NOTIFICATIONS=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_USER_CHAT_IDS={"ilya":"123456789"}

# Messenger Gateway / Telegram User Session: рабочий Telegram-аккаунт сервиса по номеру телефона.
# MESSENGER_DEFAULT_ORG_ID=default
# MESSENGER_CREDENTIAL_ENCRYPTION_KEY=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_ENCRYPTION_KEY=
# TELEGRAM_USER_SESSION_ENABLED=true

# Messenger media storage (S3-compatible/R2/MinIO). Bucket должен быть persistent и приватным.
# MESSENGER_STORAGE_ENABLED=true
# MESSENGER_STORAGE_ENDPOINT=https://s3.example.com
# MESSENGER_STORAGE_REGION=auto
# MESSENGER_STORAGE_BUCKET=eco-messenger
# MESSENGER_STORAGE_ACCESS_KEY_ID=
# MESSENGER_STORAGE_SECRET_ACCESS_KEY=
# MESSENGER_STORAGE_PUBLIC_BASE_URL=
# MESSENGER_STORAGE_FORCE_PATH_STYLE=true
# MESSENGER_AUTO_DOWNLOAD_IMAGE_MAX_MB=15
# MESSENGER_AUTO_DOWNLOAD_FILE_MAX_MB=25
# MESSENGER_UPLOAD_MAX_MB=20
# MESSENGER_MEDIA_WORKER_INTERVAL_MS=15000
# MESSENGER_MEDIA_IN_PROCESS_WORKER=true

# AQSI — чеки/касса и отправка отложенных заказов на терминал
AQSI_API_KEY=
# Базовый URL и путь чеков, если нужно переопределить
# AQSI_BASE_URL=https://api.aqsi.ru/pub
# AQSI_ORDERS_PATH=/v2/Receipts
# Путь для создания отложенных заказов
# AQSI_PENDING_ORDER_PATH=/v2/Orders/simple
# Если в AQSI несколько терминалов — укажите, куда отправлять заказ
# AQSI_DEVICE_ID=
# AQSI_SHOP_ID=
# AQSI_CASHIER_ID=
# Пароль для редкого пропуска моторного масла без кода маркировки
# AQSI_MARKING_BYPASS_PASSWORD=

# --- Деплой (например Railway): публичный origin приложения
# NEXT_PUBLIC_APP_ORIGIN=https://your-service.up.railway.app
# Можно продублировать для server-side PDF-генерации, если прокси отдаёт неверный origin.
# APP_ORIGIN=https://your-service.up.railway.app
# PDF-отчёты диагностики: путь к Chrome/Chromium. На Railway задаётся nixpacks.toml.
# CHROME_PATH=chromium
# Печать заказ-наряда/постера/бирок: реквизиты продавца на макете (см. job-order-poster-org)
# JOB_ORDER_SELLER_DIRECTOR=
# JOB_ORDER_SELLER_INN=
# JOB_ORDER_SELLER_OGRN=
# JOB_ORDER_SELLER_ADDRESS=
# JOB_ORDER_SELLER_PHONES=
# Публичный клиентский отчёт диагностики /report/[token]: Telegram — внешняя ссылка для клиента.
# PUBLIC_REPORT_PRIMARY_MESSENGER=telegram
# PUBLIC_TELEGRAM_URL=https://t.me/tamgdemaslo
# PUBLIC_TELEGRAM_USERNAME=tamgdemaslo
# NEXT_PUBLIC_COMPANY_PHONE=+79950545859
# NEXT_PUBLIC_BOOKING_URL=/client-site#/vin
# NEXT_PUBLIC_SITE_URL=tamgdemaslo.ru
# NEXT_PUBLIC_SERVICE_ADDRESS=Калининград
# Постер/бирки: POSTER_SITE, POSTER_TELEGRAM, POSTER_CITY, POSTER_PHONE — опционально (есть дефолты в коде)
# POSTER_PHONE=
